<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Home is a visual landing page; the shared top bar owns mode actions. -->
    <ui:VisualElement name="page-frag">
        <ui:ScrollView name="page-body" class="page-section menu-body-section" mode="Vertical" horizontal-scroller-visibility="Hidden">
            <ui:VisualElement class="menu-layout">
                <ui:VisualElement name="menu-info" class="menu-info" picking-mode="Ignore">
                    <ui:VisualElement class="menu-info-header">
                        <ui:Label text="SLOPARENA" class="menu-info-heading" />
                        <ui:Label text="PLAYTEST" class="menu-info-index" />
                    </ui:VisualElement>
                    <ui:Label text="WELCOME TO THE PLAYTEST" class="menu-info-declaration" />
                    <ui:Label text="Thanks for playing SlopArena. Choose a mode above and jump in." class="menu-info-copy" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
