<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Home repeats the shell's mode routes as large actions beside its announcement board. -->
    <ui:VisualElement name="page-frag">
        <ui:VisualElement name="page-body" class="page-section menu-body-section">
            <ui:VisualElement class="menu-layout">
                <ui:VisualElement class="menu-actions">
                    <ui:Button name="menu-training" text="TRAINING" class="menu-action menu-action--training" />
                    <ui:Button name="menu-solo" text="SOLO" class="menu-action menu-action--solo" />
                    <ui:Button name="menu-online" text="ONLINE" class="menu-action menu-action--online" />
                </ui:VisualElement>
                <ui:VisualElement name="menu-artwork-column" class="menu-artwork-column" picking-mode="Ignore">
                    <ui:VisualElement name="menu-artwork" class="menu-artwork" picking-mode="Ignore">
                        <ui:VisualElement class="menu-artwork-image" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-artwork-tape menu-artwork-tape--left" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-artwork-tape menu-artwork-tape--right" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="menu-info" class="menu-info">
                    <ui:Label text="ANNOUNCEMENTS" class="menu-info-heading" />
                    <ui:VisualElement name="menu-announcements" class="menu-announcements">
                        <ui:Label text="WELCOME TO THE PLAYTEST" class="menu-info-declaration" />
                        <ui:Label text="Thanks for playing SlopArena." class="menu-info-copy" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
