<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SlopArena.uss?fileID=7433441132597879392&amp;guid=a41ba556d3415bfd586226903c56f69e&amp;type=3#SlopArena" />
    <ui:VisualElement name="root" class="screen menu-screen">
        <ui:VisualElement name="backdrop" class="menu-backdrop" />
        <ui:VisualElement name="menu-content" class="menu-content">
            <ui:ScrollView name="menu-scroll" class="menu-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
            <ui:VisualElement name="menu-intro" class="menu-intro">
                <ui:VisualElement name="title-wrap" class="menu-title-wrap">
                    <ui:VisualElement class="menu-title-face">
                        <ui:Label name="title" text="SLOP" class="menu-title" />
                        <ui:Label text="ARENA" class="menu-title menu-title--arena" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="menu-title-rule" />
                <ui:Label text="AWKWARD FIGHTERS. QUESTIONABLE IDEAS." class="menu-tagline" />
                <ui:Label text="Pick a way in. The hard part is choosing who gets blamed for the rematch." class="menu-copy" />
                <ui:VisualElement name="identity-panel" class="menu-identity" />
                <ui:VisualElement name="menu-actions" class="menu-actions">
                    <ui:VisualElement class="menu-action-item">
                        <ui:Button name="btn-multiplayer" text="PLAY ONLINE" class="menu-action menu-action--primary" />
                    </ui:VisualElement>
                    <ui:VisualElement class="menu-action-item">
                        <ui:Button name="btn-solo" text="SOLO VS CPU" class="menu-action menu-action--secondary" />
                    </ui:VisualElement>
                    <ui:VisualElement class="menu-action-item">
                        <ui:Button name="btn-training" text="TRAINING" class="menu-action menu-action--paper" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="roster-column" class="menu-roster-column">
                <ui:VisualElement class="menu-roster-heading">
                    <ui:Label text="MEET THE PROBLEM" class="menu-roster-title" />
                    <ui:Label name="online-count" text="ROSTER READY" class="menu-status-pill menu-status-pill--online" />
                </ui:VisualElement>
                <ui:Label text="A different bad idea for every playstyle." class="menu-roster-intro" />
                <ui:VisualElement name="roster-panel" class="menu-roster" />
            </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="menu-footer">
            <ui:Label text="SLOPARENA // DESKTOP DEMO" class="menu-version" />
            <ui:Label text="Hone your garbage." class="menu-footer-note" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
