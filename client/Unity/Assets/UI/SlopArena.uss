.menu-screen {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(23, 19, 27);
    padding: 0;
}

.menu-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(23, 19, 27);
}

.backdrop-grid {
    position: absolute;
    left: -20%;
    right: -20%;
    top: -40%;
    bottom: -40%;
    rotate: -18deg;
    opacity: 0.12;
    background-color: rgba(240, 238, 232, 0.08);
}

.backdrop-burst {
    position: absolute;
    border-width: 4px;
    border-color: rgb(13, 13, 20);
    rotate: -8deg;
}

.backdrop-burst--orange {
    width: 460px;
    height: 330px;
    right: 60px;
    top: 100px;
    background-color: rgb(224, 92, 42);
}

.backdrop-burst--yellow {
    width: 330px;
    height: 210px;
    right: 240px;
    bottom: -60px;
    rotate: 11deg;
    background-color: rgb(255, 200, 33);
}

.backdrop-note {
    position: absolute;
    color: rgb(255, 200, 33);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.backdrop-note--left {
    left: 36%;
    bottom: 24%;
    rotate: -8deg;
}

.backdrop-note--right {
    right: 32%;
    bottom: 18%;
    color: rgb(224, 92, 42);
    rotate: 7deg;
}

.menu-header {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 7%;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.menu-title-wrap {
    position: relative;
    width: 620px;
    flex-direction: column;
    align-items: flex-start;
    rotate: -2deg;
}

.menu-kicker {
    padding: 7px 12px;
    background-color: rgb(240, 238, 232);
    color: rgb(25, 19, 27);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.menu-tape {
    padding: 7px 12px;
    background-color: rgb(240, 238, 232);
    color: rgb(25, 19, 27);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.menu-title-face {
    position: relative;
    margin-top: 16px;
}

.menu-title {
    font-size: 92px;
    line-height: 0.82;
    letter-spacing: -5px;
    color: rgb(240, 238, 232);
    -unity-font-style: bold;
}

.menu-title--shadow {
    position: absolute;
    left: 10px;
    top: 55px;
    color: rgb(224, 92, 42);
}

.menu-title--arena-shadow {
    top: 180px;
    left: 16px;
    color: rgb(13, 13, 20);
}

.menu-title-face .menu-title {
    position: relative;
    color: rgb(240, 238, 232);
}

.menu-title--arena {
    margin-top: -4px;
    color: rgb(240, 238, 232);
    -unity-text-align: middle-left;
}

.menu-title-rule {
    width: 300px;
    height: 9px;
    margin-top: 14px;
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    background-color: rgb(255, 200, 33);
}

.menu-tagline {
    margin-top: 18px;
    color: rgb(255, 200, 33);
    font-size: 20px;
    letter-spacing: 5px;
    -unity-font-style: bold;
}

.menu-status {
    flex-direction: column;
    align-items: flex-end;
}

.menu-status-pill {
    margin-bottom: 8px;
    padding: 8px 12px;
    background-color: rgb(25, 19, 27);
    color: rgb(240, 238, 232);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.menu-status-pill--online {
    border-left-width: 8px;
    border-left-color: rgb(255, 200, 33);
    color: rgb(76, 221, 136);
}

.menu-hero {
    position: absolute;
    left: 5%;
    bottom: 20%;
    width: 390px;
    flex-direction: column;
    align-items: flex-start;
}

.menu-hero .menu-tape {
    margin-bottom: 14px;
    background-color: rgb(25, 19, 27);
    color: rgb(240, 238, 232);
}

.menu-action {
    height: 60px;
    border-width: 3px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 8px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgb(240, 238, 232);
    color: rgb(25, 19, 27);
    font-size: 19px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-duration: 0.12s;
    transition-property: background-color, translate, border-color;
}

.menu-action:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.menu-action:focus {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.menu-action:active {
    translate: 0 3px;
}

.menu-action--primary {
    width: 390px;
    background-color: rgb(255, 200, 33);
}

.menu-action--primary:hover {
    background-color: rgb(255, 217, 92);
}

.menu-action--primary:focus {
    background-color: rgb(255, 217, 92);
}

.menu-action--secondary {
    width: 360px;
}

.menu-action--hot {
    background-color: rgb(224, 92, 42);
    color: rgb(240, 238, 232);
}

.menu-action--hot:hover {
    background-color: rgb(255, 118, 80);
}

.menu-action--hot:focus {
    background-color: rgb(255, 118, 80);
}

.menu-action--small {
    height: 48px;
    margin-top: 8px;
    font-size: 13px;
}

.menu-action--join {
    width: 100px;
    margin-left: 8px;
}

.menu-roster {
    position: absolute;
    right: 5%;
    top: 7%;
    width: 390px;
    rotate: 2deg;
}

.menu-roster-header {
    height: 40px;
    padding: 11px 14px;
    border-left-width: 8px;
    border-left-color: rgb(255, 200, 33);
    background-color: rgb(25, 19, 27);
    color: rgb(240, 238, 232);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.menu-roster-card {
    position: relative;
    height: 86px;
    margin-top: 10px;
    padding: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(13, 13, 20, 0.94);
    border-bottom-width: 6px;
}

.menu-roster-card--orange {
    border-bottom-color: rgb(224, 92, 42);
}

.menu-roster-card--blue {
    border-bottom-color: rgb(59, 130, 246);
}

.menu-roster-card--green {
    border-bottom-color: rgb(34, 197, 94);
}

.menu-portrait {
    width: 70px;
    height: 70px;
    margin-right: 12px;
    border-width: 3px;
    border-color: rgb(240, 238, 232);
    background-color: rgb(224, 92, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.menu-portrait--fightguy {
    background-image: resource('UI/Portraits/FightGuy');
}

.menu-portrait--manki {
    background-image: resource('UI/Portraits/Manki');
}

.menu-portrait--kistu {
    background-color: rgb(224, 92, 42);
}

.menu-roster-copy {
    flex-direction: column;
    justify-content: center;
}

.menu-fighter-name {
    color: rgb(240, 238, 232);
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.menu-fighter-role {
    margin-top: 5px;
    color: rgba(240, 238, 232, 0.68);
    font-size: 10px;
    letter-spacing: 1px;
}

.menu-player-badge {
    position: absolute;
    right: 12px;
    top: 12px;
    padding: 4px 7px;
    background-color: rgb(240, 238, 232);
    color: rgb(25, 19, 27);
    font-size: 11px;
    -unity-font-style: bold;
}

.menu-actions {
    position: absolute;
    left: 5%;
    bottom: 7%;
    width: 390px;
    flex-direction: column;
}

.menu-submenu {
    width: 360px;
    margin-top: 4px;
    padding-left: 14px;
    flex-direction: column;
}

.menu-input-row {
    width: 360px;
    flex-direction: row;
    align-items: center;
}

.menu-input {
    flex-grow: 1;
    height: 42px;
    margin-top: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    background-color: rgb(240, 238, 232);
    color: rgb(25, 19, 27);
    font-size: 11px;
}

.menu-input:focus {
    border-color: rgb(255, 200, 33);
    background-color: rgb(255, 249, 230);
}

.global-chat {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 330px;
    height: 190px;
    padding: 10px;
    flex-direction: column;
    background-color: rgba(13, 13, 20, 0.94);
    border-width: 2px;
    border-color: rgba(240, 238, 232, 0.28);
    border-bottom-width: 5px;
    border-bottom-color: rgb(224, 92, 42);
}

.global-chat__header {
    height: 24px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 6px;
    background-color: rgb(25, 19, 27);
    border-left-width: 4px;
    border-left-color: rgb(255, 200, 33);
}

.global-chat__title,
.global-chat__online {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.global-chat__title { color: rgb(240, 238, 232); }
.global-chat__online { color: rgb(76, 221, 136); }

.global-chat__feed {
    flex-grow: 1;
    min-height: 0;
    margin: 8px 0;
    padding: 6px;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(240, 238, 232, 0.06);
}

.global-chat__message {
    margin-bottom: 4px;
    color: rgba(240, 238, 232, 0.82);
    font-size: 11px;
    white-space: normal;
}

.global-chat__message--accent { color: rgb(255, 200, 33); }
.global-chat__message--hot { color: rgb(224, 92, 42); }

.global-chat__input-row {
    height: 30px;
    flex-direction: row;
    align-items: center;
}

.global-chat__input {
    flex-grow: 1;
    height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: rgba(240, 238, 232, 0.28);
    background-color: rgb(240, 238, 232);
    color: rgb(25, 19, 27);
    font-size: 10px;
}

.global-chat__input:focus {
    border-color: rgb(255, 200, 33);
    background-color: rgb(255, 249, 230);
}

.global-chat__send {
    width: 38px;
    height: 30px;
    margin-left: 6px;
    padding: 0;
    border-width: 1px;
    border-color: rgb(13, 13, 20);
    background-color: rgb(255, 200, 33);
    color: rgb(25, 19, 27);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.global-chat__send:hover,
.global-chat__send:focus { background-color: rgb(255, 217, 92); }

.menu-chat {
    position: absolute;
    left: 5%;
    bottom: 7%;
    margin-left: 430px;
    width: 330px;
    height: 190px;
    rotate: -2deg;
}

.screen > .global-chat {
    z-index: 10;
}

.direct-connect-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 30;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 20, 0.72);
}

.direct-connect-card {
    width: 420px;
    padding: 22px;
    flex-direction: column;
    background-color: rgb(25, 19, 27);
    border-width: 3px;
    border-color: rgb(240, 238, 232);
    border-bottom-width: 7px;
    border-bottom-color: rgb(224, 92, 42);
}

.direct-connect-title {
    color: rgb(255, 200, 33);
    font-size: 22px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.direct-connect-copy {
    margin-top: 8px;
    color: rgba(240, 238, 232, 0.72);
    font-size: 12px;
}

.direct-connect-input {
    width: 100%;
    height: 44px;
    margin-top: 18px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 2px;
    border-color: rgba(240, 238, 232, 0.36);
    background-color: rgb(240, 238, 232);
    color: rgb(25, 19, 27);
    font-size: 13px;
}

.direct-connect-input:focus {
    border-color: rgb(255, 200, 33);
    background-color: rgb(255, 249, 230);
}

.direct-connect-status {
    min-height: 18px;
    margin-top: 8px;
    color: rgb(255, 200, 33);
    font-size: 11px;
    white-space: normal;
}

.direct-connect-status.error { color: rgb(255, 111, 94); }
.direct-connect-status.success { color: rgb(76, 221, 136); }

.direct-connect-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.direct-connect-actions .menu-action {
    width: 150px;
}

.menu-version {
    position: absolute;
    right: 5%;
    bottom: 4%;
    color: rgba(240, 238, 232, 0.58);
    font-size: 10px;
    letter-spacing: 2px;
}

.btn-primary {
    width: 240px;
    height: 52px;
    margin-top: 24px;
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(25, 26, 58);
    background-color: rgb(255, 200, 33);
    color: rgb(25, 26, 58);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    border-bottom-width: 6px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.btn-primary:hover {
    background-color: rgb(255, 217, 92);
    translate: 0 -2px;
}

.btn-primary:focus {
    background-color: rgb(255, 217, 92);
    translate: 0 -2px;
}

.btn-primary:active {
    translate: 0 2px;
}

.btn-primary:disabled {
    background-color: rgb(74, 74, 102);
    border-color: rgb(74, 74, 102);
    color: rgb(122, 122, 153);
}

.btn-secondary {
    width: 240px;
    height: 52px;
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(25, 26, 58);
    background-color: rgb(255, 255, 255);
    color: rgb(25, 26, 58);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    border-bottom-width: 6px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.btn-secondary:hover {
    background-color: rgb(232, 236, 255);
    translate: 0 -2px;
}

.btn-secondary:focus {
    background-color: rgb(232, 236, 255);
    translate: 0 -2px;
}

.btn-secondary:active {
    translate: 0 2px;
}

.btn-back {
    position: absolute;
    top: 24px;
    left: 24px;
    width: 100px;
    height: 36px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(232, 236, 255);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.btn-back:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.btn-back:focus {
    background-color: rgba(255, 255, 255, 0.14);
}

.player-list {
    flex-direction: column;
    width: 360px;
    background-color: rgb(22, 22, 42);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(46, 46, 80);
    padding: 16px 24px;
}

.player-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    border-bottom-width: 1px;
    border-color: rgb(46, 46, 80);
}

.player-row.unity-last-child {
    border-bottom-width: 0;
}

.player-id {
    font-size: 18px;
    color: rgb(240, 238, 232);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.player-status {
    font-size: 12px;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 2px;
}

.player-status--connected {
    color: rgb(76, 221, 136);
    background-color: rgba(76, 221, 136, 0.1);
    border-width: 1px;
    border-color: rgba(76, 221, 136, 0.3);
}

.player-status--waiting {
    color: rgb(122, 122, 153);
    background-color: rgba(122, 122, 153, 0.1);
    border-width: 1px;
    border-color: rgb(46, 46, 80);
}

.char-select-screen {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(20, 17, 24);
    padding: 0;
}

.char-select-title {
    position: absolute;
    left: 48px;
    top: 36px;
    color: rgb(240, 238, 232);
    font-size: 18px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.char-select-meta {
    position: absolute;
    right: 52px;
    top: 42px;
    color: rgb(240, 238, 232);
    font-size: 11px;
    letter-spacing: 1px;
}

.char-grid {
    position: absolute;
    left: 230px;
    right: 42px;
    top: 120px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.char-card {
    width: 190px;
    height: 250px;
    margin: 0 7px;
    padding: 0;
    border-radius: 0;
    background-color: rgb(30, 27, 36);
    border-width: 1px;
    border-color: rgb(62, 57, 70);
    overflow: hidden;
    transition-duration: 0.12s;
    transition-property: translate, border-color, background-color;
}

.char-card:hover,
.char-card--selected {
    translate: 0 -8px;
    border-width: 2px;
    border-color: rgb(255, 198, 35);
    background-color: rgb(42, 37, 46);
}

.char-portrait {
    flex-grow: 1;
    width: 100%;
    background-color: rgb(44, 40, 49);
    -unity-background-scale-mode: scale-and-crop;
}

.char-card-name {
    height: 42px;
    padding-left: 12px;
    padding-top: 10px;
    color: rgb(240, 238, 232);
    background-color: rgb(28, 25, 33);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.char-markers {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 8px;
    flex-direction: row;
    flex-wrap: wrap;
}

.char-marker {
    margin-right: 4px;
    padding: 4px 6px;
    color: rgb(20, 17, 24);
    background-color: rgb(255, 198, 35);
    font-size: 10px;
    -unity-font-style: bold;
}

.char-marker--selecting {
    background-color: rgb(240, 238, 232);
}

.char-marker--ready {
    background-color: rgb(76, 221, 136);
}

.selection-copy {
    position: absolute;
    left: 230px;
    right: 42px;
    top: 392px;
    align-items: center;
}

.char-name {
    margin-bottom: 2px;
    color: rgb(240, 238, 232);
    font-size: 27px;
    letter-spacing: 5px;
    -unity-font-style: bold;
}

.char-role {
    color: rgb(255, 198, 35);
    font-size: 11px;
    letter-spacing: 2px;
}

.pvp-panel {
    position: absolute;
    left: 258px;
    right: 42px;
    bottom: 24px;
    flex-direction: row;
    align-items: flex-end;
}

.player-cards-area {
    flex-grow: 1;
    min-width: 0;
    align-items: center;
    justify-content: center;
}

.roster-panel {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    width: 100%;
}

.player-card {
    width: 150px;
    height: 132px;
    margin-right: 8px;
    padding: 8px;
    flex-shrink: 0;
    background-color: rgb(30, 27, 36);
    border-width: 1px;
    border-color: rgb(62, 57, 70);
    border-bottom-width: 4px;
    border-bottom-color: rgb(224, 92, 42);
}

.player-card--local {
    border-color: rgb(255, 198, 35);
    border-bottom-color: rgb(255, 198, 35);
}

.player-card__identity {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.player-card__number {
    color: rgb(255, 198, 35);
    font-size: 14px;
    -unity-font-style: bold;
}

.player-card__host {
    color: rgb(122, 122, 153);
    font-size: 8px;
    letter-spacing: 1px;
}

.player-card__name {
    margin-top: 2px;
    color: rgb(240, 238, 232);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.player-card__portrait {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 42px;
    height: 42px;
    background-color: rgb(44, 40, 49);
    -unity-background-scale-mode: scale-and-crop;
}

.player-card__character {
    margin-top: 12px;
    color: rgb(240, 238, 232);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.player-card__waiting {
    flex-grow: 1;
    margin-top: 24px;
    color: rgb(122, 122, 153);
    font-size: 9px;
    white-space: normal;
}

.player-card__status {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    color: rgb(240, 238, 232);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.player-card__status--locked {
    color: rgb(76, 221, 136);
}

.player-card__status--picking {
    color: rgb(255, 198, 35);
}

.pvp-action-area {
    width: 190px;
    margin-left: 8px;
    align-items: flex-end;
}

.pvp-status {
    margin-bottom: 8px;
    color: rgb(122, 122, 153);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: middle-right;
}

.pvp-buttons {
    flex-direction: column;
    align-items: flex-end;
}

.pvp-btn {
    width: 180px;
    height: 40px;
    margin-top: 6px;
    border-radius: 0;
    font-size: 11px;
}

#btn-select {
    position: absolute;
    right: 42px;
    bottom: 32px;
    width: 180px;
}

#btn-back {
    position: absolute;
    right: 42px;
    bottom: 8px;
}

.stage-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    max-width: 700px;
    margin-bottom: 20px;
}

.stage-card {
    width: 180px;
    height: 120px;
    margin: 8px;
    border-radius: 4px;
    background-color: rgb(30, 30, 54);
    border-width: 1px;
    border-color: rgb(46, 46, 80);
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 12px;
    overflow: hidden;
    transition-duration: 0.1s;
    transition-property: border-color, background-color;
}

.stage-card:hover {
    border-color: rgb(224, 92, 42);
    background-color: rgb(42, 42, 70);
}

.stage-card--selected {
    border-color: rgb(224, 92, 42);
    border-width: 2px;
    background-color: rgb(42, 42, 70);
}

.stage-card .stage-name {
    font-size: 13px;
    color: rgb(240, 238, 232);
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.stage-swatch {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 32px;
    opacity: 0.35;
}

.server-list {
    flex-direction: column;
    width: 480px;
    max-height: 360px;
    overflow: scroll;
    background-color: rgb(22, 22, 42);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(46, 46, 80);
    padding: 8px 0;
}

.server-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    border-bottom-width: 1px;
    border-color: rgb(46, 46, 80);
    padding-left: 16px;
    padding-right: 16px;
}

.server-row.unity-last-child {
    border-bottom-width: 0;
}

.server-name {
    font-size: 14px;
    color: rgb(240, 238, 232);
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-grow: 1;
}

.server-info {
    font-size: 12px;
    color: rgb(122, 122, 153);
    letter-spacing: 1px;
    margin-right: 12px;
}

.server-join {
    width: 80px;
    height: 32px;
    border-radius: 3px;
    background-color: rgb(224, 92, 42);
    border-width: 0;
    color: rgb(240, 238, 232);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.server-join:hover {
    background-color: rgb(240, 112, 64);
}

.lobby-room {
    width: 520px;
}

.lobby-room #lbl-server {
    margin-bottom: 20px;
}

.player-list.lobby-list {
    width: 100%;
    padding: 8px 12px;
}

.player-slot {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 12px;
    border-bottom-width: 1px;
    border-color: rgb(46, 46, 80);
}

.player-slot.unity-last-child {
    border-bottom-width: 0;
}

.slot-index {
    width: 36px;
    color: rgb(122, 122, 153);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.slot-name {
    flex-grow: 1;
    color: rgb(240, 238, 232);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.slot-name--empty {
    color: rgb(74, 74, 102);
    -unity-font-style: normal;
}

.host-badge {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(224, 92, 42);
    border-width: 1px;
    border-color: rgb(224, 92, 42);
    border-radius: 2px;
    padding: 2px 6px;
    margin-left: 8px;
}

.chat-placeholder {
    width: 100%;
    height: 120px;
    margin-top: 16px;
    margin-bottom: 16px;
    border-radius: 4px;
    background-color: rgb(19, 19, 31);
    border-width: 1px;
    border-color: rgb(46, 46, 80);
    -unity-text-align: middle-center;
    justify-content: center;
}

.lobby-buttons {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    margin-top: 8px;
}

.lobby-buttons .btn-primary {
    margin: 0 8px;
}

.lobby-buttons .btn-secondary {
    margin: 0 8px;
}

.btn-secondary {
    width: 240px;
    height: 52px;
    border-radius: 3px;
    background-color: rgb(30, 30, 54);
    border-width: 1px;
    border-color: rgb(46, 46, 80);
    color: rgb(240, 238, 232);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    transition-duration: 0.1s;
    transition-property: border-color, background-color;
}

.btn-secondary:hover {
    border-color: rgb(224, 92, 42);
    background-color: rgb(42, 42, 70);
}

.pvp-panel {
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
    margin-top: 8px;
    display: none;
}

.roster-panel {
    flex-direction: column;
    width: 100%;
    background-color: rgb(22, 22, 42);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(46, 46, 80);
    padding: 8px 12px;
}

.roster-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-color: rgb(46, 46, 80);
}

.roster-row.unity-last-child {
    border-bottom-width: 0;
}

.roster-host {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(224, 92, 42);
    border-width: 1px;
    border-color: rgb(224, 92, 42);
    border-radius: 2px;
    padding: 1px 4px;
    margin-right: 8px;
}

.roster-name {
    flex-grow: 1;
    color: rgb(240, 238, 232);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.roster-char {
    color: rgb(74, 74, 102);
    font-size: 12px;
    letter-spacing: 1px;
    margin-right: 12px;
    min-width: 80px;
    -unity-text-align: middle-left;
}

.roster-char--picked {
    color: rgb(240, 238, 232);
    -unity-font-style: bold;
}

.roster-lock {
    font-size: 10px;
    letter-spacing: 1px;
    padding: 2px 8px;
    border-radius: 2px;
}

.roster-lock--picking {
    color: rgb(122, 122, 153);
    background-color: rgba(122, 122, 153, 0.1);
    border-width: 1px;
    border-color: rgb(46, 46, 80);
}

.roster-lock--locked {
    color: rgb(76, 221, 136);
    background-color: rgba(76, 221, 136, 0.1);
    border-width: 1px;
    border-color: rgba(76, 221, 136, 0.3);
}

.pvp-status {
    font-size: 12px;
    color: rgb(122, 122, 153);
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.pvp-buttons {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    margin-top: 4px;
}

.pvp-btn {
    margin: 0 8px;
}
