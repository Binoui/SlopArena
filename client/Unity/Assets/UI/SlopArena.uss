/* ============================================================
   SlopArena.uss — shared styles for all menu screens
   MainMenu / Lobby / CharSelect / StageSelect
   ============================================================ */

/* ── Variables (repeat these values site-wide) ──────────────
   bg-dark:       #0d0d1a
   bg-panel:      #16162a
   bg-card:       #1e1e36
   accent:        #e05c2a   (orange)
   accent-hover:  #f07040
   text-primary:  #f0eee8
   text-muted:    #7a7a99
   border:        #2e2e50
   ──────────────────────────────────────────────────────────── */

/* ── Screen root ─────────────────────────────────────────── */

.screen {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background-color: #191a3a;
    background-image: linear-gradient(180deg, #2f6bff 0%, #3d1ad4 100%);
    padding: 40px;
}

/* ── Backdrop — static scene (spec §5) ───────────────────── */

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.bkg-sun {
    position: absolute;
    top: 48px;
    right: 12%;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: #ffc821;
}

.bkg-cloud {
    position: absolute;
    border-radius: 40px;
    background-color: rgba(255, 255, 255, 0.55);
}

.bkg-cloud--1 { top: 64px;  left: 10%; width: 200px; height: 44px; }
.bkg-cloud--2 { top: 140px; left: 34%; width: 140px; height: 34px; }

.bkg-hill {
    position: absolute;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
}

.bkg-hill--left  { bottom: 0; left: -140px; width: 620px; height: 320px; background-color: #1d4fbf; }
.bkg-hill--right { bottom: 0; right: -180px; width: 760px; height: 400px; background-color: #1a44a8; }

.bkg-platform {
    position: absolute;
    background-color: #e8ecff;
    border-width: 3px;
    border-color: #191a3a;
    border-radius: 14px;
    border-bottom-width: 6px;
}

.bkg-platform--main  { bottom: 96px;  left: 50%; margin-left: -230px; width: 460px; height: 34px; }
.bkg-platform--left  { bottom: 180px; left: 8%;  width: 120px; height: 22px; rotate: -6deg; }
.bkg-platform--right { bottom: 180px; right: 8%; width: 120px; height: 22px; rotate: 6deg; }

.bkg-fighter {
    position: absolute;
    bottom: 130px;
    width: 26px;
    height: 34px;
    border-width: 3px;
    border-color: #191a3a;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.bkg-fighter--1 { background-color: #ff4d3d;    left: 50%; margin-left: -46px; }
.bkg-fighter--2 { background-color: #2f6bff;       left: 50%; margin-left: -8px;  }
.bkg-fighter--3 { background-color: #ffc821; left: 50%; margin-left: 30px;  }

/* ── Header: logo + status ───────────────────────────────── */

.header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: 28px 40px 0 40px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.title-wrap {
    position: relative;
}

.title {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 64px;
    letter-spacing: 2px;
    color: #ffffff;
    -unity-text-align: middle-left;
}

.title--shadow3 { color: #191a3a; translate: 6px 6px; }
.title--shadow2 { color: #191a3a; translate: 4px 4px; }
.title--shadow1 { color: #191a3a; translate: 2px 2px; }
.title--face    { position: relative; }

.title-stripes {
    width: 260px;
    height: 10px;
    margin-top: 12px;
    border-radius: 5px;
    border-width: 2px;
    border-color: #191a3a;
    background-color: #ffc821;
}

.status-area {
    flex-direction: row;
    align-items: center;
}

.status-pill {
    background-color: rgba(19, 18, 45, 0.85);
    border-width: 2px;
    border-color: #191a3a;
    border-radius: 10px;
    padding: 6px 14px;
    color: #e8ecff;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    margin-left: 10px;
}

.status-pill--online { color: #4cdd88; }
.status-pill--host   { color: #e8ecff; }

/* ── Center: TRAINING hero ───────────────────────────────── */

.center-col {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 340px;
    margin-left: -170px;
    flex-direction: column;
    align-items: center;
}

.btn-hero {
    width: 320px;
    height: 64px;
    border-radius: 16px;
    border-width: 3px;
    border-color: #191a3a;
    background-color: #ffc821;
    color: #191a3a;
    font-size: 20px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    border-bottom-width: 6px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.btn-hero:hover  { background-color: #ffd95c; translate: 0 -2px; }
.btn-hero:active { translate: 0 3px; }

.hero-tagline {
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

/* ── Overlay panels: chat (left) + multiplayer (right) ───── */

.chat-panel,
.mp-panel {
    position: absolute;
    bottom: 36px;
    flex-direction: column;
    background-color: rgba(19, 18, 45, 0.85);
    border-width: 3px;
    border-color: #191a3a;
    border-radius: 14px;
    padding: 14px;
    border-bottom-width: 6px;
}

.chat-panel { left: 36px; width: 320px; }
.mp-panel   { right: 36px; width: 300px; }

.chat-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.chat-title {
    color: #ffc821;
    font-size: 13px;
    letter-spacing: 2px;
}

.chat-online {
    color: #7a7a99;
    font-size: 10px;
    letter-spacing: 1px;
}

.chat-feed {
    height: 120px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 8px;
    flex-direction: column;
}

.chat-msg {
    font-size: 11px;
    color: #e8ecff;
    white-space: normal;
    margin-bottom: 4px;
}

.chat-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.chat-input-row .ip-input {
    flex-grow: 1;
    margin-right: 8px;
}

.chat-send {
    width: 44px;
    height: 36px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #191a3a;
    background-color: #ffc821;
    color: #191a3a;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.chat-send:hover { background-color: #ffd95c; }

.mp-header {
    height: 36px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    border-width: 0;
    color: #ffc821;
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.mp-header:hover { background-color: rgba(255, 255, 255, 0.12); }

.mp-body {
    flex-direction: column;
    margin-top: 10px;
}

.menu-item {
    width: 100%;
    height: 44px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-radius: 12px;
    border-width: 3px;
    border-color: #191a3a;
    background-color: #ffffff;
    color: #191a3a;
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    border-bottom-width: 6px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.menu-item:hover  { background-color: #e8ecff; translate: 0 -2px; }
.menu-item:active { translate: 0 2px; }

.menu-item--join {
    background-color: #ff4d3d;
    color: #ffffff;
}

.menu-item--join:hover { background-color: #ff6f5e; }

.join-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.join-row .menu-item--join {
    flex-grow: 1;
    margin-right: 8px;
}

.join-row .ip-input {
    flex-grow: 1;
}

.ip-input {
    height: 36px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #191a3a;
    background-color: #ffffff;
    color: #191a3a;
    font-size: 11px;
    padding-left: 10px;
    padding-right: 10px;
}

.ip-input:focus {
    border-color: #ffc821;
    background-color: #fff9e6;
}

/* ── Version pill ────────────────────────────────────────── */

.version-pill {
    position: absolute;
    left: 50%;
    bottom: 36px;
    margin-left: -50px;
    width: 100px;
    background-color: #191a3a;
    color: #ffc821;
    font-size: 10px;
    letter-spacing: 2px;
    padding: 6px 0;
    border-radius: 12px;
    -unity-text-align: middle-center;
}

/* ── Shared action buttons (other screens inherit) ───────── */

.btn-primary {
    width: 240px;
    height: 52px;
    margin-top: 24px;
    border-radius: 14px;
    border-width: 3px;
    border-color: #191a3a;
    background-color: #ffc821;
    color: #191a3a;
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    border-bottom-width: 6px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.btn-primary:hover  { background-color: #ffd95c; translate: 0 -2px; }
.btn-primary:active { translate: 0 2px; }

.btn-primary:disabled {
    background-color: #4a4a66;
    border-color: #4a4a66;
    color: #7a7a99;
}

.btn-secondary {
    width: 240px;
    height: 52px;
    border-radius: 14px;
    border-width: 3px;
    border-color: #191a3a;
    background-color: #ffffff;
    color: #191a3a;
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    border-bottom-width: 6px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.btn-secondary:hover  { background-color: #e8ecff; translate: 0 -2px; }
.btn-secondary:active { translate: 0 2px; }

.btn-back {
    position: absolute;
    top: 24px;
    left: 24px;
    width: 100px;
    height: 36px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
    background-color: rgba(0, 0, 0, 0);
    color: #e8ecff;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.btn-back:hover {
    background-color: #ffffff;
    color: #191a3a;
}

/* ── Lobby ───────────────────────────────────────────────── */

.player-list {
    flex-direction: column;
    width: 360px;
    background-color: #16162a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #2e2e50;
    padding: 16px 24px;
}

.player-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    border-bottom-width: 1px;
    border-color: #2e2e50;
}

.player-row.unity-last-child {
    border-bottom-width: 0;
}

.player-id {
    font-size: 18px;
    color: #f0eee8;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.player-status {
    font-size: 12px;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 2px;
}

.player-status--connected {
    color: #4cdd88;
    background-color: rgba(76, 221, 136, 0.1);
    border-width: 1px;
    border-color: rgba(76, 221, 136, 0.3);
}

.player-status--waiting {
    color: #7a7a99;
    background-color: rgba(122, 122, 153, 0.1);
    border-width: 1px;
    border-color: #2e2e50;
}

/* ── CharSelect ──────────────────────────────────────────── */

.char-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    max-width: 480px;
    margin-bottom: 20px;
}

/* Character portrait cards — populated at runtime */
/* CharSelectController adds these classes to Button children */
.char-card {
    width: 96px;
    height: 96px;
    margin: 6px;
    border-radius: 4px;
    background-color: #1e1e36;
    border-width: 1px;
    border-color: #2e2e50;
    -unity-text-align: middle-center;
    color: #f0eee8;
    font-size: 11px;
    letter-spacing: 1px;
    transition-duration: 0.1s;
    transition-property: border-color, background-color;
}

.char-card:hover {
    border-color: #e05c2a;
    background-color: #2a2a46;
}

.char-card--selected {
    border-color: #e05c2a;
    border-width: 2px;
    background-color: #2a2a46;
}

/* Preview panel — 3-column: abilities | model | abilities */
.preview-panel {
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    max-width: 820px;
    height: 340px;
    background-color: #16162a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #2e2e50;
    margin-bottom: 16px;
    padding: 16px;
}

.model-col {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.char-name {
    font-size: 20px;
    color: #f0eee8;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.model-viewport {
    flex-grow: 1;
    width: 100%;
    max-width: 260px;
    border-radius: 3px;
    overflow: hidden;
    background-color: #0d0d1a;
    border-width: 1px;
    border-color: #2e2e50;
}

.model-image {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

/* Ability columns */
.abilities-col {
    flex-direction: column;
    justify-content: center;
    width: 200px;
    padding: 0 8px;
}

.ability-card {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 8px;
    margin-bottom: 8px;
    border-radius: 3px;
    background-color: #1e1e36;
    border-width: 1px;
    border-color: #2e2e50;
}

.ability-key {
    width: 24px;
    height: 24px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #e05c2a;
    background-color: #2a2a46;
    border-radius: 3px;
    border-width: 1px;
    border-color: #e05c2a;
    margin-right: 8px;
    flex-shrink: 0;
}

.ability-info {
    flex-direction: column;
    flex-grow: 1;
}

.ability-name {
    font-size: 12px;
    color: #f0eee8;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.ability-desc {
    font-size: 10px;
    color: #7a7a99;
    white-space: normal;
}

/* ── StageSelect ─────────────────────────────────────────── */

.stage-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    max-width: 700px;
    margin-bottom: 20px;
}

/* Stage cards — populated at runtime by StageSelectController */
.stage-card {
    width: 180px;
    height: 120px;
    margin: 8px;
    border-radius: 4px;
    background-color: #1e1e36;
    border-width: 1px;
    border-color: #2e2e50;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 12px;
    overflow: hidden;
    transition-duration: 0.1s;
    transition-property: border-color, background-color;
}

.stage-card:hover {
    border-color: #e05c2a;
    background-color: #2a2a46;
}

.stage-card--selected {
    border-color: #e05c2a;
    border-width: 2px;
    background-color: #2a2a46;
}

.stage-card .stage-name {
    font-size: 13px;
    color: #f0eee8;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.stage-swatch {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 32px;
    opacity: 0.35;
}


/* ── Server Browser ───────────────────────────────────────── */

.server-list {
    flex-direction: column;
    width: 480px;
    max-height: 360px;
    overflow: scroll;
    background-color: #16162a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #2e2e50;
    padding: 8px 0;
}

.server-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    border-bottom-width: 1px;
    border-color: #2e2e50;
    padding-left: 16px;
    padding-right: 16px;
}

.server-row.unity-last-child {
    border-bottom-width: 0;
}

.server-name {
    font-size: 14px;
    color: #f0eee8;
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-grow: 1;
}

.server-info {
    font-size: 12px;
    color: #7a7a99;
    letter-spacing: 1px;
    margin-right: 12px;
}

.server-join {
    width: 80px;
    height: 32px;
    border-radius: 3px;
    background-color: #e05c2a;
    border-width: 0;
    color: #f0eee8;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.server-join:hover {
    background-color: #f07040;
}

/* ── Lobby Room (SignalR, issue #33) ─────────────────────── */

.lobby-room {
    width: 520px;
}

.lobby-room #lbl-server {
    margin-bottom: 20px;
}

.player-list.lobby-list {
    width: 100%;
    padding: 8px 12px;
}

.player-slot {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 12px;
    border-bottom-width: 1px;
    border-color: #2e2e50;
}

.player-slot.unity-last-child {
    border-bottom-width: 0;
}

.slot-index {
    width: 36px;
    color: #7a7a99;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.slot-name {
    flex-grow: 1;
    color: #f0eee8;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.slot-name--empty {
    color: #4a4a66;
    -unity-font-style: normal;
}

.host-badge {
    font-size: 10px;
    letter-spacing: 1px;
    color: #e05c2a;
    border-width: 1px;
    border-color: #e05c2a;
    border-radius: 2px;
    padding: 2px 6px;
    margin-left: 8px;
}

.chat-placeholder {
    width: 100%;
    height: 120px;
    margin-top: 16px;
    margin-bottom: 16px;
    border-radius: 4px;
    background-color: #13131f;
    border-width: 1px;
    border-color: #2e2e50;
    -unity-text-align: middle-center;
    justify-content: center;
}

.lobby-buttons {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    margin-top: 8px;
}

.lobby-buttons .btn-primary,
.lobby-buttons .btn-secondary {
    margin: 0 8px;
}

.btn-secondary {
    width: 240px;
    height: 52px;
    border-radius: 3px;
    background-color: #1e1e36;
    border-width: 1px;
    border-color: #2e2e50;
    color: #f0eee8;
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    transition-duration: 0.1s;
    transition-property: border-color, background-color;
}

.btn-secondary:hover {
    border-color: #e05c2a;
    background-color: #2a2a46;
}

/* ── CharSelect PvP (issue #34) ──────────────────────────── */
.pvp-panel {
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
    margin-top: 8px;
    display: none; /* shown by CharSelectController in PvP mode */
}

.roster-panel {
    flex-direction: column;
    width: 100%;
    background-color: #16162a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #2e2e50;
    padding: 8px 12px;
}

.roster-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-color: #2e2e50;
}

.roster-row.unity-last-child {
    border-bottom-width: 0;
}

.roster-host {
    font-size: 9px;
    letter-spacing: 1px;
    color: #e05c2a;
    border-width: 1px;
    border-color: #e05c2a;
    border-radius: 2px;
    padding: 1px 4px;
    margin-right: 8px;
}

.roster-name {
    flex-grow: 1;
    color: #f0eee8;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.roster-char {
    color: #4a4a66;
    font-size: 12px;
    letter-spacing: 1px;
    margin-right: 12px;
    min-width: 80px;
    -unity-text-align: middle-left;
}

.roster-char--picked {
    color: #f0eee8;
    -unity-font-style: bold;
}

.roster-lock {
    font-size: 10px;
    letter-spacing: 1px;
    padding: 2px 8px;
    border-radius: 2px;
}

.roster-lock--picking {
    color: #7a7a99;
    background-color: rgba(122, 122, 153, 0.1);
    border-width: 1px;
    border-color: #2e2e50;
}

