.screen {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(23, 19, 27);
}

.menu-screen,
.char-select-screen {
    background-color: rgb(23, 19, 27);
    color: rgb(240, 238, 232);
    font-size: 18px;
}

.menu-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(23, 19, 27);
}

.menu-backdrop {
    background-color: rgb(23, 19, 27);
    border-right-width: 14px;
    border-right-color: rgb(224, 92, 42);
}

.flow-header-copy {
    margin-left: 128px;
    align-items: flex-start;
}

.flow-eyebrow,
.flow-progress,
.char-select-meta,
.stage-host-status,
.panel-note,
.lobby-panel__capacity,
.footer-label,
.field-label {
    font-size: 14px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.flow-eyebrow,
.flow-progress,
.footer-label {
    color: rgb(255, 200, 33);
}

.flow-title,
.char-name,
.direct-connect-title {
    -unity-font-definition: url("../Fonts/Baloo2.asset");
    -unity-font-style: bold;
}


.flow-title {
    margin-top: 3px;
    color: rgb(240, 238, 232);
    font-size: 58px;
    letter-spacing: -1px;
}

.flow-subtitle {
    margin-top: 10px;
    color: rgb(196, 189, 197);
    font-size: 19px;
    white-space: normal;
}

.flow-context {
    max-width: 360px;
    margin-left: auto;
    padding: 12px 16px;
    border-left-width: 7px;
    border-left-color: rgb(255, 200, 33);
    background-color: rgb(13, 13, 20);
    color: rgb(240, 238, 232);
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.btn-primary,
.btn-secondary,
.btn-hot,
.btn-back {
    border-radius: 0;
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 6px;
    min-height: 56px;
    padding-left: 18px;
    padding-right: 18px;
    color: rgb(25, 19, 27);
    font-size: 18px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
    transition-property: translate, background-color, border-color;
}


.btn-primary {
    background-color: rgb(255, 200, 33);
}

.btn-primary:hover,
.btn-primary:focus {
    background-color: rgb(255, 217, 92);
    border-color: rgb(240, 238, 232);
    translate: 0 -2px;
}

.btn-primary:active,
.btn-secondary:active,
.btn-hot:active {
    translate: 0 3px;
}

.btn-primary:disabled {
    background-color: rgb(83, 77, 91);
    border-color: rgb(83, 77, 91);
    color: rgb(165, 158, 168);
}

.btn-secondary {
    background-color: rgb(240, 238, 232);
}

.btn-secondary:hover,
.btn-secondary:focus {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.btn-hot {
    background-color: rgb(224, 92, 42);
    color: rgb(23, 19, 27);
}

.btn-hot:hover,
.btn-hot:focus {
    background-color: rgb(255, 118, 80);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.btn-back {
    width: 108px;
    min-height: 48px;
    background-color: rgb(13, 13, 20);
    color: rgb(240, 238, 232);
    border-color: rgb(240, 238, 232);
    font-size: 16px;
}

.btn-back:hover,
.btn-back:focus {
    background-color: rgb(224, 92, 42);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.panel-title {
    color: rgb(240, 238, 232);
    font-size: 22px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.panel-note {
    color: rgb(183, 174, 184);
    font-size: 13px;
}





.browser-layout {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
}

.browser-panel,
.lobby-panel {
    min-width: 0;
    padding: 20px;
    background-color: rgb(13, 13, 20);
    border-width: 3px;
    border-color: rgb(240, 238, 232);
    border-bottom-width: 9px;
    border-bottom-color: rgb(224, 92, 42);
}

.browser-panel__header,
.lobby-panel__header,
.browser-panel__footer,
.lobby-panel__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.browser-panel__header,
.lobby-panel__header {
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(240, 238, 232, 0.26);
}

.browser-panel__footer,
.lobby-panel__footer {
    margin-top: 14px;
}

.server-list,
.player-list.lobby-list {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    margin-top: 12px;
    flex-direction: column;
    overflow: scroll;
}

.server-row,
.player-slot {
    min-height: 68px;
    margin-top: 8px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(35, 30, 40);
    border-left-width: 6px;
    border-left-color: rgb(255, 200, 33);
    border-bottom-width: 4px;
    border-bottom-color: rgb(13, 13, 20);
}

.server-row.unity-first-child,
.player-slot.unity-first-child {
    margin-top: 0;
}

.server-row.unity-last-child,
.player-slot.unity-last-child {
    margin-bottom: 0;
}

.server-name,
.slot-name {
    flex-grow: 1;
    min-width: 0;
    color: rgb(240, 238, 232);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.server-info {
    margin-left: 14px;
    margin-right: 16px;
    color: rgb(196, 189, 197);
    font-size: 16px;
    white-space: nowrap;
}

.server-join {
    width: 112px;
    min-height: 48px;
    flex-shrink: 0;
    background-color: rgb(224, 92, 42);
    color: rgb(240, 238, 232);
    font-size: 16px;
}

.server-join:hover,
.server-join:focus {
    background-color: rgb(255, 118, 80);
    border-color: rgb(255, 200, 33);
}

.browser-status,
.lobby-status {
    min-height: 24px;
    margin-top: 10px;
    color: rgb(255, 200, 33);
    font-size: 18px;
    white-space: normal;
}

.browser-status.error,
.lobby-status.error {
    color: rgb(255, 118, 80);
}

.browser-hint {
    flex-grow: 1;
    min-width: 0;
    color: rgb(240, 238, 232);
    font-size: 18px;
    white-space: normal;
}

.field-help {
    flex-grow: 1;
    min-width: 0;
    color: rgb(72, 65, 76);
    font-size: 17px;
    white-space: normal;
}

.browser-refresh {
    width: 145px;
    flex-shrink: 0;
    margin-left: 14px;
}

.browser-tools {
    width: 340px;
    min-width: 0;
    margin-left: 12px;
    flex-shrink: 0;
    flex-direction: column;
}

.browser-tool {
    padding: 20px;
    background-color: rgb(240, 238, 232);
    border-width: 3px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 8px;
    border-bottom-color: rgb(255, 200, 33);
}

.browser-host-panel {
    flex-grow: 1;
}

.browser-direct-panel {
    margin-top: 14px;
    background-color: rgb(224, 92, 42);
    border-bottom-color: rgb(13, 13, 20);
}

.browser-tool .panel-title {
    color: rgb(25, 19, 27);
}

.browser-direct-panel .panel-title {
    color: rgb(23, 19, 27);
}

.tool-copy {
    margin-top: 8px;
    color: rgb(72, 65, 76);
    font-size: 18px;
    white-space: normal;
}

.browser-direct-panel .tool-copy {
    color: rgb(23, 19, 27);
}

.field-label {
    margin-top: 18px;
    color: rgb(72, 65, 76);
    font-size: 14px;
}

.browser-input,
.direct-connect-input {
    width: 100%;
    min-height: 50px;
    margin-top: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    background-color: rgb(255, 255, 255);
    color: rgb(25, 19, 27);
    font-size: 18px;
}

.browser-input:focus,
.direct-connect-input:focus {
    border-color: rgb(255, 200, 33);
    background-color: rgb(255, 249, 230);
}

.host-status {
    min-height: 25px;
    margin-top: 8px;
    color: rgb(25, 19, 27);
    font-size: 17px;
    white-space: normal;
}

.direct-connect-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 20, 0.84);
}

.direct-connect-card {
    width: 560px;
    max-width: 82%;
    padding: 28px;
    background-color: rgb(240, 238, 232);
    border-width: 3px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 9px;
    border-bottom-color: rgb(224, 92, 42);
}

.direct-connect-title {
    color: rgb(25, 19, 27);
    font-size: 38px;
}

.direct-connect-copy {
    margin-top: 10px;
    color: rgb(72, 65, 76);
    font-size: 19px;
    white-space: normal;
}

.direct-connect-card .field-label {
    color: rgb(72, 65, 76);
}

.direct-connect-status {
    min-height: 25px;
    margin-top: 9px;
    color: rgb(142, 85, 0);
    font-size: 17px;
    white-space: normal;
}

.direct-connect-status.error {
    color: rgb(155, 42, 30);
}

.direct-connect-status.success {
    color: rgb(35, 119, 69);
}

.direct-connect-actions {
    margin-top: 16px;
    flex-direction: row;
    justify-content: flex-end;
}

.direct-connect-actions > .btn-secondary,
.direct-connect-actions > .btn-hot {
    width: 170px;
}

.direct-connect-actions > .btn-hot {
    margin-left: 10px;
}

.lobby-panel__capacity {
    color: rgb(183, 174, 184);
    font-size: 14px;
}

.lobby-retry {
    width: 220px;
    min-height: 45px;
    margin-top: 8px;
    font-size: 15px;
}

.lobby-action {
    width: 170px;
    margin-left: 10px;
}

.lobby-action--start {
    width: 230px;
}

.slot-index,
.player-id {
    width: 52px;
    color: rgb(255, 200, 33);
    font-size: 18px;
    -unity-font-style: bold;
}

.slot-name--empty {
    color: rgb(183, 174, 184);
    -unity-font-style: normal;
}

.host-badge {
    margin-left: 10px;
    padding: 5px 8px;
    background-color: rgb(255, 200, 33);
    color: rgb(25, 19, 27);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.char-select-screen {
    background-color: rgb(20, 17, 24);
}

.char-select-header {
    min-height: 96px;
}

.char-select-header .flow-header-copy {
    width: 72%;
    min-width: 0;
}

.char-select-header .flow-title {
    white-space: normal;
}

.char-header-status,
.stage-header-status {
    margin-left: auto;
    align-items: flex-end;
}

.char-select-meta {
    margin-top: 13px;
    color: rgb(183, 174, 184);
    font-size: 14px;
}

.char-main {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 24%;
    bottom: 34%;
    flex-direction: column;
}

.char-grid {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    padding: 0 1% 10px;
}

.char-card {
    width: 22%;
    min-width: 155px;
    max-width: 300px;
    min-height: 230px;
    margin: 0 7px;
    padding: 0;
    background-color: rgb(36, 32, 43);
    border-width: 2px;
    border-color: rgb(66, 59, 73);
    border-bottom-width: 6px;
    overflow: hidden;
    transition-duration: 0.12s;
    transition-property: translate, border-color, background-color, scale;
}

.char-card--selected {
    translate: 0 -7px;
    scale: 1.02;
    background-color: rgb(48, 42, 52);
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: rgb(255, 204, 34);
}

.char-card:hover {
    translate: 0 -5px;
    border-color: rgb(241, 235, 221);
}
.char-card:focus {
    translate: 0 -5px;
    border-color: rgb(255, 204, 34);
}
.char-card--selected:hover,
.char-card--selected:focus {
    translate: 0 -7px;
    border-color: rgb(255, 218, 74);
    border-bottom-color: rgb(255, 204, 34);
}

.char-portrait {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    overflow: hidden;
    background-color: rgb(44, 40, 49);
    background-position: center;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(220, 213, 222);
}
.char-card:hover .char-portrait,
.char-card:focus .char-portrait,
.char-card--selected .char-portrait {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}


.char-card-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 50px;
    padding-left: 14px;
    padding-right: 8px;
    color: rgb(214, 207, 218);
    background-color: rgba(29, 26, 35, 0.97);
    font-size: 19px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}
.char-card--selected .char-card-name {
    color: rgb(255, 218, 74);
    background-color: rgba(41, 36, 46, 0.98);
    font-size: 20px;
}
.char-card:hover .char-card-name,
.char-card:focus .char-card-name { color: rgb(241, 235, 221); }
.char-card--selected:hover .char-card-name,
.char-card--selected:focus .char-card-name { color: rgb(255, 218, 74); }

.char-markers {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.char-marker {
    margin-right: 5px;
    margin-bottom: 5px;
    padding: 5px 7px;
    color: rgb(20, 17, 24);
    background-color: rgb(255, 200, 33);
    font-size: 13px;
    -unity-font-style: bold;
}

.char-marker--selecting {
    background-color: rgb(240, 238, 232);
}

.char-marker--ready {
    background-color: rgb(76, 221, 136);
}

.selection-copy {
    min-height: 53px;
    align-items: center;
    justify-content: center;
}

.char-name {
    color: rgb(240, 238, 232);
    font-size: 32px;
    letter-spacing: 1px;
}

.char-role {
    margin-top: 3px;
    color: rgb(255, 200, 33);
    font-size: 18px;
    white-space: normal;
}

.pvp-panel {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 5%;
    min-height: 190px;
    flex-direction: row;
    align-items: stretch;
    display: none;
}

.player-cards-area {
    flex-grow: 0;
    width: auto;
    min-width: 0;
    justify-content: flex-start;
}

.roster-panel {
    width: auto;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
}

.player-card {
    width: 172px;
    min-height: 174px;
    margin-right: 10px;
    padding: 11px;
    flex-shrink: 0;
    background-color: rgb(35, 30, 40);
    border-width: 2px;
    border-color: rgb(83, 77, 91);
    border-bottom-width: 5px;
    border-bottom-color: rgb(224, 92, 42);
}

.player-card--local {
    border-color: rgb(255, 200, 33);
    border-bottom-color: rgb(255, 200, 33);
}
.player-card--editing {
    border-width: 3px;
    border-color: rgb(240, 238, 232);
    border-bottom-width: 6px;
    border-bottom-color: rgb(255, 200, 33);
    background-color: rgb(52, 45, 55);
}


.player-card__identity {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.player-card__number {
    color: rgb(255, 200, 33);
    font-size: 18px;
    -unity-font-style: bold;
}

.player-card__host {
    color: rgb(183, 174, 184);
    font-size: 13px;
    letter-spacing: 1px;
}

.player-card__name {
    margin-top: 3px;
    color: rgb(240, 238, 232);
    font-size: 17px;
    -unity-font-style: bold;
}

.player-card__portrait {
    position: relative;
    align-self: flex-end;
    width: 62px;
    height: 62px;
    margin-top: 6px;
    background-color: rgb(44, 40, 49);
    -unity-background-scale-mode: scale-and-crop;
}
.player-card__character {
    margin-top: 7px;
    color: rgb(240, 238, 232);
    font-size: 17px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.player-card__waiting {
    flex-grow: 1;
    margin-top: 18px;
    color: rgb(183, 174, 184);
    font-size: 15px;
    white-space: normal;
}

.player-card__status {
    margin-top: 10px;
    max-width: 100%;
    color: rgb(240, 238, 232);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.player-card__status--locked {
    color: rgb(76, 221, 136);
}

.player-card__status--picking {
    color: rgb(255, 200, 33);
}
.player-card__status--editing {
    color: rgb(255, 200, 33);
}


.solo-config {
    width: 440px;
    min-width: 440px;
    margin-left: 10px;
    padding: 16px 18px;
    background-color: rgb(36, 32, 43);
    border-width: 2px;
    border-color: rgb(66, 59, 73);
    border-bottom-width: 6px;
    align-items: stretch;
    display: none;
}

.selection-target {
    color: rgb(241, 235, 221);
    font-size: 17px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.selection-target-buttons {
    margin-top: 12px;
    flex-direction: row;
}

.selection-target-button {
    width: 50%;
    min-height: 42px;
    padding-left: 5px;
    padding-right: 5px;
    background-color: rgb(36, 32, 43);
    color: rgb(241, 235, 221);
    border-width: 2px;
    border-color: rgb(66, 59, 73);
    border-bottom-width: 4px;
    font-size: 15px;
}
#btn-edit-player { margin-right: 6px; }
.selection-target-button:hover,
.selection-target-button:focus {
    background-color: rgb(55, 49, 62);
    border-color: rgb(255, 204, 34);
}
.selection-target-button.active {
    background-color: rgb(255, 204, 34);
    border-color: rgb(255, 204, 34);
    color: rgb(21, 18, 25);
}
.selection-target-button.active:hover,
.selection-target-button.active:focus {
    background-color: rgb(255, 218, 74);
    border-color: rgb(241, 235, 221);
}

.solo-difficulty-buttons {
    width: 100%;
    margin-top: 12px;
    flex-direction: row;
}
.solo-difficulty-button {
    width: 33%;
    min-height: 42px;
    margin-right: 5px;
    padding-left: 3px;
    padding-right: 3px;
    background-color: rgb(36, 32, 43);
    border-color: rgb(66, 59, 73);
    color: rgb(241, 235, 221);
    font-size: 14px;
    letter-spacing: 0;
}
#btn-cpu-difficulty-hard { margin-right: 0; }
.solo-difficulty-button:hover,
.solo-difficulty-button:focus {
    background-color: rgb(55, 49, 62);
    border-color: rgb(255, 204, 34);
    color: rgb(241, 235, 221);
}
.solo-difficulty-button.active {
    background-color: rgb(255, 204, 34);
    border-color: rgb(255, 204, 34);
    color: rgb(21, 18, 25);
}
.solo-difficulty-button.active:hover,
.solo-difficulty-button.active:focus {
    background-color: rgb(255, 218, 74);
    border-color: rgb(241, 235, 221);
}

.pvp-action-area {
    width: 220px;
    min-width: 220px;
    margin-left: 10px;
    align-items: stretch;
}

.pvp-status {
    margin-bottom: 8px;
    color: rgb(196, 189, 197);
    font-size: 16px;
    white-space: normal;
}

.pvp-buttons {
    flex-direction: column;
    align-items: stretch;
}

.pvp-btn {
    width: 100%;
    min-height: 49px;
    margin-top: 7px;
    font-size: 16px;
}

.solo-next-action {
    width: 190px;
    min-width: 190px;
    margin-left: 10px;
    align-items: stretch;
    justify-content: flex-end;
}

.solo-next-action > .btn-primary {
    width: 100%;
    min-height: 57px;
}

.stage-host-status {
    margin-top: 14px;
    padding: 8px 11px;
    background-color: rgb(13, 13, 20);
    color: rgb(255, 200, 33);
    font-size: 14px;
}

.stage-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    padding: 4px;
}

.stage-card {
    width: 22%;
    min-width: 0;
    height: 180px;
    margin: 6px;
    flex-shrink: 0;
    background-color: rgb(35, 30, 40);
    border-width: 2px;
    border-color: rgb(83, 77, 91);
    border-bottom-width: 5px;
    border-bottom-color: rgb(224, 92, 42);
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    overflow: hidden;
    transition-duration: 0.12s;
    transition-property: translate, border-color, background-color;
}

.stage-card:hover,
.stage-card:focus {
    translate: 0 -4px;
    border-color: rgb(240, 238, 232);
    background-color: rgb(52, 45, 55);
}

.stage-card--selected {
    translate: 0 -6px;
    border-color: rgb(255, 200, 33);
    border-width: 3px;
    background-color: rgb(52, 45, 55);
}

.stage-swatch {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.72;
    -unity-background-scale-mode: scale-and-crop;
}

.stage-card .stage-name {
    min-height: 43px;
    padding: 10px 10px 7px;
    background-color: rgba(13, 13, 20, 0.88);
    color: rgb(240, 238, 232);
    font-size: 18px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.stage-player-cards {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: stretch;
}

.stage-player-cards .player-card {
    width: 176px;
    min-height: 174px;
}

.stage-selected-label,
.stage-waiting {
    margin-bottom: 9px;
    color: rgb(240, 238, 232);
    font-size: 17px;
    letter-spacing: 1px;
    white-space: normal;
}

.stage-waiting {
    color: rgb(255, 200, 33);
}

.stage-confirm {
    width: 100%;
    min-height: 52px;
    font-size: 17px;
}


.results-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(20, 17, 24);
}

.results-grid {
    position: absolute;
    left: 36%;
    right: -18%;
    top: -38%;
    bottom: -46%;
    rotate: -17deg;
    opacity: 0.13;
    border-width: 2px;
    border-color: rgba(240, 238, 232, 0.16);
    background-color: rgba(240, 238, 232, 0.04);
}

.results-burst {
    position: absolute;
    border-width: 4px;
    border-color: rgb(13, 13, 20);
    rotate: -8deg;
}

.results-burst--orange {
    width: 520px;
    height: 320px;
    right: -30px;
    top: 110px;
    background-color: rgb(224, 92, 42);
    opacity: 0.8;
}

.results-burst--yellow {
    width: 380px;
    height: 180px;
    right: 230px;
    bottom: -40px;
    rotate: 12deg;
    background-color: rgb(255, 200, 33);
    opacity: 0.78;
}

.results-background-note {
    position: absolute;
    color: rgb(255, 200, 33);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-background-note--left {
    left: 38%;
    bottom: 25%;
    rotate: -7deg;
}

.results-background-note--right {
    right: 8%;
    top: 31%;
    color: rgb(224, 92, 42);
    rotate: 7deg;
}

.results-header-copy {
    flex-direction: column;
    align-items: flex-start;
    rotate: -2deg;
}

.results-eyebrow {
    padding: 7px 12px;
    background-color: rgb(240, 238, 232);
    color: rgb(20, 17, 24);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-headline {
    margin-top: 8px;
    color: rgb(240, 238, 232);
    font-size: 48px;
    line-height: 0.82;
    letter-spacing: -2px;
    -unity-font-style: bold;
}

.results-stage {
    margin-top: 10px;
    color: rgb(255, 200, 33);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-metadata {
    margin-top: 8px;
    padding: 8px 12px;
    background-color: rgb(25, 19, 27);
    color: rgb(240, 238, 232);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-content {
    flex-grow: 1;
    min-width: 0;
    position: relative;
    flex-direction: row;
    z-index: 2;
}

.results-winner {
    width: 57%;
    min-width: 0;
    margin-right: 18px;
}

.results-winner-card {
    position: relative;
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
    background-color: rgb(240, 238, 232);
    border-width: 3px;
    border-color: rgb(13, 13, 20);
    border-left-width: 12px;
    border-bottom-width: 9px;
    translate: -36px 0;
    opacity: 0;
    transition-duration: 0.28s;
    transition-property: translate, opacity;
}

.results-ready .results-winner-card {
    translate: 0 0;
    opacity: 1;
}

.results-winner-placement {
    position: absolute;
    left: 22px;
    top: 12px;
    z-index: 2;
    color: rgb(224, 92, 42);
    font-size: 86px;
    line-height: 0.8;
    letter-spacing: -5px;
    -unity-font-style: bold;
}

.results-winner-label {
    position: absolute;
    left: 28px;
    top: 100px;
    z-index: 2;
    color: rgb(20, 17, 24);
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.results-winner-portrait {
    width: 48%;
    height: 100%;
    margin-left: auto;
    margin-right: 0;
    background-color: rgb(44, 40, 49);
    -unity-background-scale-mode: scale-and-crop;
}

.results-winner-copy {
    position: absolute;
    left: 28px;
    right: 48%;
    bottom: 22px;
    align-items: flex-start;
}

.results-winner-player {
    color: rgb(20, 17, 24);
    font-size: 26px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.results-winner-fighter {
    margin-top: 4px;
    color: rgb(224, 92, 42);
    font-size: 13px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.results-winner-stats {
    flex-direction: row;
    margin-top: 22px;
}

.results-stat {
    min-width: 64px;
    margin-right: 16px;
    padding-top: 6px;
    border-top-width: 3px;
    border-top-color: rgb(20, 17, 24);
}

.results-stat-value {
    color: rgb(20, 17, 24);
    font-size: 24px;
    -unity-font-style: bold;
}

.results-stat-label {
    margin-top: 2px;
    color: rgb(20, 17, 24);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.results-standings {
    flex-grow: 1;
    min-width: 0;
    padding-left: 0;
    flex-direction: column;
    align-items: stretch;
}

.results-standings-label {
    height: 26px;
    padding: 7px 10px;
    background-color: rgb(25, 19, 27);
    color: rgb(255, 200, 33);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-player-row {
    min-height: 82px;
    margin-top: 7px;
    padding: 8px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(240, 238, 232);
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    border-left-width: 8px;
    border-bottom-width: 5px;
    translate: 30px 0;
    opacity: 0;
    transition-duration: 0.22s;
    transition-property: translate, opacity;
}

.results-ready .results-player-row {
    translate: 0 0;
    opacity: 1;
}

.results-row-placement {
    width: 42px;
    color: rgb(224, 92, 42);
    font-size: 28px;
    letter-spacing: -1px;
    -unity-font-style: bold;
}

.results-row-portrait {
    width: 54px;
    height: 62px;
    background-color: rgb(44, 40, 49);
    -unity-background-scale-mode: scale-and-crop;
}

.results-row-identity {
    flex-grow: 1;
    min-width: 0;
    margin-left: 12px;
    align-items: flex-start;
}

.results-row-player {
    color: rgb(20, 17, 24);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.results-row-fighter {
    margin-top: 4px;
    color: rgb(224, 92, 42);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-row-stats {
    flex-direction: row;
    align-items: center;
}

.results-row-stats .results-stat {
    min-width: 42px;
    margin-right: 8px;
    padding-top: 4px;
    border-top-width: 2px;
}

.results-row-stats .results-stat-value {
    font-size: 18px;
}

.results-row-stats .results-stat-label {
    font-size: 8px;
}

.results-actions {
    flex-grow: 1;
    min-width: 0;
    align-items: flex-end;
    justify-content: flex-end;
    opacity: 0;
    translate: 0 18px;
    transition-duration: 0.22s;
    transition-property: opacity, translate;
}

.results-actions.results-ready {
    opacity: 1;
    translate: 0 0;
}

.results-actions-eyebrow,
.results-actions-future {
    color: rgb(240, 238, 232);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-actions-eyebrow {
    color: rgb(255, 200, 33);
}

.results-actions-future {
    margin-top: 8px;
    margin-bottom: 12px;
    color: rgba(240, 238, 232, 0.56);
}

.results-return {
    width: 260px;
    height: 52px;
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 7px;
    background-color: rgb(255, 200, 33);
    color: rgb(20, 17, 24);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.results-return:hover,
.results-return:focus {
    background-color: rgb(255, 217, 92);
    translate: 0 -2px;
}

.results-count-2 .results-winner {
    width: 62%;
}

.results-count-2 .results-player-row {
    min-height: 105px;
}

.results-count-3 .results-player-row,
.results-count-4 .results-player-row {
    min-height: 72px;
}

.results-count-3 .results-row-portrait,
.results-count-4 .results-row-portrait {
    width: 46px;
    height: 52px;
}
