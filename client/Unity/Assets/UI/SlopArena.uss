    align-items: center;
    background-color: rgb(240, 238, 232);
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    border-left-width: 8px;
    border-bottom-width: 5px;
    translate: 30px 0;
    opacity: 0;
    transition-duration: 0.22s;
    transition-property: translate, opacity;
}

.results-ready .results-player-row {
    translate: 0 0;
    opacity: 1;
}

.results-row-placement {
    width: 42px;
    color: rgb(224, 92, 42);
    font-size: 28px;
    letter-spacing: -1px;
    -unity-font-style: bold;
}

.results-row-portrait {
    width: 54px;
    height: 62px;
    background-color: rgb(44, 40, 49);
    -unity-background-scale-mode: scale-and-crop;
}

.results-row-identity {
    flex-grow: 1;
    min-width: 0;
    margin-left: 12px;
    align-items: flex-start;
}

.results-row-player {
    color: rgb(20, 17, 24);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.results-row-fighter {
    margin-top: 4px;
    color: rgb(224, 92, 42);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-row-stats {
    flex-direction: row;
    align-items: center;
}

.results-row-stats .results-stat {
    min-width: 42px;
    margin-right: 8px;
    padding-top: 4px;
    border-top-width: 2px;
}

.results-row-stats .results-stat-value {
    font-size: 18px;
}

.results-row-stats .results-stat-label {
    font-size: 8px;
}

.results-footer {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 24px;
    height: 190px;
    flex-direction: row;
    align-items: stretch;
    z-index: 3;
}

.results-chat {
    position: relative;
    left: auto;
    bottom: auto;
    width: 46%;
    height: auto;
    margin-right: 18px;
    flex-shrink: 0;
    transform-origin: center;
    rotate: -1deg;
}

.results-actions {
    flex-grow: 1;
    min-width: 0;
    align-items: flex-end;
    justify-content: flex-end;
    opacity: 0;
    translate: 0 18px;
    transition-duration: 0.22s;
    transition-property: opacity, translate;
}

.results-ready .results-actions {
    opacity: 1;
    translate: 0 0;
}

.results-actions-eyebrow,
.results-actions-future {
    color: rgb(240, 238, 232);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.results-actions-eyebrow {
    color: rgb(255, 200, 33);
}

.results-actions-future {
    margin-top: 8px;
    margin-bottom: 12px;
    color: rgba(240, 238, 232, 0.56);
}

.results-return {
    width: 260px;
    height: 52px;
    border-radius: 0;
    border-width: 3px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 7px;
    background-color: rgb(255, 200, 33);
    color: rgb(20, 17, 24);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.results-return:hover,
.results-return:focus {
    background-color: rgb(255, 217, 92);
    translate: 0 -2px;
}

.results-count-2 .results-winner {
    width: 62%;
}

.results-count-2 .results-player-row {
    min-height: 105px;
}

.results-count-3 .results-player-row,
.results-count-4 .results-player-row {
    min-height: 72px;
}

.results-count-3 .results-row-portrait,
.results-count-4 .results-row-portrait {
    width: 46px;
    height: 52px;
}
