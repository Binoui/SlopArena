.screen {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(23, 19, 27);
}

.menu-screen,
.char-select-screen {
    background-color: rgb(23, 19, 27);
    color: rgb(240, 238, 232);
    font-size: 18px;
}

.menu-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(23, 19, 27);
}

.menu-backdrop {
    background-color: rgb(23, 19, 27);
    border-right-width: 14px;
    border-right-color: rgb(224, 92, 42);
}

.flow-header-copy {
    margin-left: 128px;
    align-items: flex-start;
}

.flow-eyebrow,
.flow-progress,
.char-select-meta,
.stage-host-status,
.panel-note,
.lobby-panel__capacity,
.footer-label,
.field-label {
    font-size: 14px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}

.flow-eyebrow,
.flow-progress,
.footer-label {
    color: rgb(255, 200, 33);
}

.flow-title,
.char-name,
.direct-connect-title {
    -unity-font-definition: url("../Fonts/Baloo2.asset");
    -unity-font-style: bold;
}


.flow-title {
    margin-top: 3px;
    color: rgb(240, 238, 232);
    font-size: 58px;
    letter-spacing: -1px;
}

.flow-subtitle {
    margin-top: 10px;
    color: rgb(196, 189, 197);
    font-size: 19px;
    white-space: normal;
}

.frontend-shell .flow-eyebrow,
.frontend-shell .flow-progress {
    color: var(--shell-page-muted);
}

.flow-context {
    max-width: 360px;
    margin-left: auto;
    padding: 12px 16px;
    border-left-width: 7px;
    border-left-color: rgb(255, 200, 33);
    background-color: rgb(13, 13, 20);
    color: rgb(240, 238, 232);
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.btn-primary,
.btn-secondary,
.btn-hot,
.btn-back {
    border-radius: 0;
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 6px;
    min-height: 56px;
    padding-left: 18px;
    padding-right: 18px;
    color: rgb(25, 19, 27);
    font-size: 18px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
    transition-property: translate, background-color, border-color;
}


.btn-primary {
    background-color: rgb(255, 200, 33);
}

.btn-primary:hover,
.btn-primary:focus {
    background-color: rgb(255, 217, 92);
    border-color: rgb(240, 238, 232);
    translate: 0 -2px;
}

.btn-primary:active,
.btn-secondary:active,
.btn-hot:active {
    translate: 0 3px;
}

.btn-primary:disabled {
    background-color: rgb(83, 77, 91);
    border-color: rgb(83, 77, 91);
    color: rgb(165, 158, 168);
}

.btn-secondary {
    background-color: rgb(240, 238, 232);
}

.btn-secondary:hover,
.btn-secondary:focus {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.btn-hot {
    background-color: rgb(224, 92, 42);
    color: rgb(23, 19, 27);
}

.btn-hot:hover,
.btn-hot:focus {
    background-color: rgb(255, 118, 80);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.btn-back {
    width: 108px;
    min-height: 48px;
    background-color: rgb(13, 13, 20);
    color: rgb(240, 238, 232);
    border-color: rgb(240, 238, 232);
    font-size: 16px;
}

.btn-back:hover,
.btn-back:focus {
    background-color: rgb(224, 92, 42);
    border-color: rgb(255, 200, 33);
    translate: 0 -2px;
}

.panel-title {
    color: rgb(240, 238, 232);
    font-size: 22px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.panel-note {
    color: rgb(183, 174, 184);
    font-size: 13px;
}





.browser-layout {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
}

.browser-panel,
.lobby-panel {
    min-width: 0;
    padding: 20px;
    background-color: rgb(37, 36, 34);
    border-width: 3px;
    border-color: rgb(123, 120, 114);
    border-bottom-width: 9px;
    border-bottom-color: rgb(255, 204, 34);
}

.browser-panel__header,
.lobby-panel__header,
.browser-panel__footer,
.lobby-panel__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.browser-panel__header,
.lobby-panel__header {
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(240, 238, 232, 0.26);
}

.browser-panel__footer,
.lobby-panel__footer {
    margin-top: 14px;
}

.server-list,
.player-list.lobby-list {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    margin-top: 12px;
    flex-direction: column;
    overflow: scroll;
}

.server-row,
.player-slot {
    min-height: 68px;
    margin-top: 8px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 21, 19);
    border-left-width: 6px;
    border-left-color: rgb(255, 204, 34);
    border-bottom-width: 4px;
    border-bottom-color: rgb(37, 36, 34);
}

.server-row.unity-first-child,
.player-slot.unity-first-child {
    margin-top: 0;
}

.server-row.unity-last-child,
.player-slot.unity-last-child {
    margin-bottom: 0;
}

.server-name,
.slot-name {
    flex-grow: 1;
    min-width: 0;
    color: rgb(240, 238, 232);
    font-size: 20px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    white-space: normal;
}

.server-info {
    margin-left: 14px;
    margin-right: 16px;
    color: rgb(196, 189, 197);
    font-size: 16px;
    white-space: nowrap;
}

.server-join {
    width: 112px;
    min-height: 48px;
    flex-shrink: 0;
    background-color: rgb(255, 204, 34);
    color: rgb(22, 21, 19);
    font-size: 16px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.server-join:hover,
.server-join:focus {
    background-color: rgb(255, 217, 92);
    border-color: rgb(240, 238, 232);
}

.server-join:disabled {
    background-color: rgb(83, 77, 70);
    border-color: rgb(123, 120, 114);
    color: rgb(240, 238, 232);
}

.frontend-shell .browser-summary-section .browser-status,
.frontend-shell .lobby-summary-section .lobby-status {
    color: var(--shell-page-warning);
}

.frontend-shell .browser-summary-section .browser-status.error,
.frontend-shell .lobby-summary-section .lobby-status.error {
    color: var(--shell-page-error);
}


.frontend-shell .browser-hint {
    flex-grow: 1;
    min-width: 0;
    color: var(--shell-page-ink);
    font-size: 18px;
    white-space: normal;
}

.field-help {
    flex-grow: 1;
    min-width: 0;
    color: rgb(37, 36, 34);
    font-size: 17px;
    white-space: normal;
}
.browser-refresh {
    width: 145px;
    flex-shrink: 0;
    margin-left: 14px;
}

.browser-tools {
    width: 340px;
    min-width: 0;
    margin-left: 12px;
    flex-shrink: 0;
    flex-direction: column;
}

.browser-tool {
    padding: 20px;
    background-color: rgb(240, 238, 232);
    border-width: 3px;
    border-color: rgb(22, 21, 19);
    border-bottom-width: 8px;
    border-bottom-color: rgb(255, 204, 34);
}

.browser-host-panel {
    flex-grow: 1;
}

.browser-direct-panel {
    margin-top: 14px;
    background-color: rgb(240, 238, 232);
    border-bottom-color: rgb(22, 21, 19);
}

.browser-tool .panel-title {
    color: rgb(22, 21, 19);
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.browser-tool .panel-title {
    white-space: normal;
    font-size: 19px;
}

.browser-tool .tool-copy {
    font-size: 15px;
}

.browser-direct-panel .panel-title {
    color: rgb(22, 21, 19);
}

.tool-copy {
    margin-top: 8px;
    color: rgb(37, 36, 34);
    font-size: 18px;
    white-space: normal;
}

.browser-direct-panel .tool-copy {
    color: rgb(37, 36, 34);
}

.field-label {
    margin-top: 18px;
    color: rgb(37, 36, 34);
    font-size: 14px;
}

.browser-input,
.direct-connect-input {
    width: 100%;
    min-height: 50px;
    margin-top: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 2px;
    border-color: rgb(123, 120, 114);
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    font-size: 18px;
}

.browser-input .unity-base-text-field__input,
.direct-connect-input .unity-base-text-field__input {
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
}

.browser-input .unity-base-text-field__input--placeholder,
.direct-connect-input .unity-base-text-field__input--placeholder {
    color: rgb(196, 189, 179);
}

.browser-input:focus,
.direct-connect-input:focus,
.browser-input:focus .unity-base-text-field__input,
.direct-connect-input:focus .unity-base-text-field__input {
    border-color: rgb(255, 204, 34);
    background-color: rgb(22, 21, 19);
}

.frontend-shell .browser-summary-section .host-status {
    min-height: 25px;
    margin-top: 8px;
    color: var(--shell-page-ink);
    font-size: 17px;
    white-space: normal;
}

.browser-tool .btn-hot,
.browser-actions-section .btn-hot,
.direct-connect-actions > .btn-hot {
    background-color: rgb(255, 204, 34);
    color: rgb(22, 21, 19);
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.browser-tool .btn-hot:hover,
.browser-tool .btn-hot:focus,
.browser-actions-section .btn-hot:hover,
.browser-actions-section .btn-hot:focus,
.direct-connect-actions > .btn-hot:hover,
.direct-connect-actions > .btn-hot:focus {
    background-color: rgb(255, 217, 92);
    border-color: rgb(240, 238, 232);
}

.browser-tool .btn-hot:disabled,
.browser-actions-section .btn-hot:disabled,
.direct-connect-actions > .btn-hot:disabled {
    background-color: rgb(83, 77, 70);
    border-color: rgb(123, 120, 114);
    color: rgb(240, 238, 232);
}

.browser-header-section .btn-back,
.browser-panel .panel-title,
.browser-refresh,
.browser-actions-section .btn-secondary,
.direct-connect-actions > .btn-secondary {
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    letter-spacing: 0;
}

.browser-header-section .btn-back {
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-color: rgb(13, 13, 20);
}

.browser-header-section .btn-back:hover,
.browser-header-section .btn-back:focus,
.browser-refresh:focus,
.browser-actions-section .btn-secondary:focus,
.direct-connect-actions > .btn-secondary:focus {
    background-color: rgb(27, 26, 24);
    color: rgb(240, 238, 232);
    border-color: rgb(255, 204, 34);
    translate: 0 0;
}

.browser-header-section .btn-back:active,
.browser-refresh:active,
.browser-actions-section .btn-secondary:active,
.direct-connect-actions > .btn-secondary:active {
    translate: 0 3px;
}

.browser-input .unity-base-text-field__input:focus,
.direct-connect-input .unity-base-text-field__input:focus {
    border-color: rgb(255, 204, 34);
    border-width: 2px;
}

.browser-refresh:disabled,
.browser-actions-section .btn-secondary:disabled,
.direct-connect-actions > .btn-secondary:disabled {
    background-color: rgb(37, 36, 34);
    color: rgb(183, 180, 173);
    border-color: rgb(123, 120, 114);
    translate: 0 0;
}

.browser-tool .btn-hot:disabled:active,
.browser-actions-section .btn-hot:disabled:active,
.server-join:disabled:active,
.direct-connect-actions > .btn-hot:disabled:active {
    translate: 0 0;
}


.page-modal-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.direct-connect-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.84);
}

.direct-connect-card {
    width: 560px;
    max-width: 82%;
    padding: 28px;
    background-color: rgb(240, 238, 232);
    border-width: 3px;
    border-color: rgb(22, 21, 19);
    border-bottom-width: 9px;
    border-bottom-color: rgb(255, 204, 34);
}

.direct-connect-title {
    color: rgb(22, 21, 19);
    font-size: 38px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.direct-connect-copy {
    margin-top: 10px;
    color: rgb(37, 36, 34);
    font-size: 19px;
    white-space: normal;
}

.direct-connect-card .field-label {
    color: rgb(37, 36, 34);
}

.direct-connect-status {
    min-height: 25px;
    margin-top: 9px;
    color: rgb(123, 85, 0);
    font-size: 17px;
    white-space: normal;
}

.direct-connect-status.error {
    color: rgb(155, 42, 30);
}

.direct-connect-status.success {
    color: rgb(28, 104, 59);
}

.direct-connect-actions {
    margin-top: 16px;
    flex-direction: row;
    justify-content: flex-end;
}

.direct-connect-actions > .btn-secondary,
.direct-connect-actions > .btn-hot {
    width: 170px;
}

.direct-connect-actions > .btn-hot {
    margin-left: 10px;
}

.lobby-panel__capacity {
    color: rgb(240, 238, 232);
    font-size: 14px;
}

.lobby-retry {
    width: 220px;
    min-height: 45px;
    margin-top: 8px;
    font-size: 15px;
}

.lobby-action {
    width: 170px;
    margin-left: 10px;
}

.lobby-action--start {
    width: 230px;
}

.slot-index,
.player-id {
    width: 52px;
    color: rgb(255, 204, 34);
    font-size: 18px;
    -unity-font-style: bold;
}

.slot-name--empty {
    color: rgb(196, 189, 179);
    -unity-font-style: normal;
}

.host-badge {
    margin-left: 10px;
    padding: 5px 8px;
    background-color: rgb(255, 204, 34);
    color: rgb(22, 21, 19);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.char-select-screen {
    background-color: rgb(20, 17, 24);
}

.char-select-header {
    min-height: 96px;
}

.char-select-header .flow-header-copy {
    width: 72%;
    min-width: 0;
}

.char-select-header .flow-title {
    white-space: normal;
}

.char-header-status,
.stage-header-status {
    margin-left: auto;
    align-items: flex-end;
}

.frontend-shell .char-select-meta {
    margin-top: 13px;
    color: var(--shell-page-muted);
    font-size: 14px;
}

.char-main {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 24%;
    bottom: 34%;
    flex-direction: column;
}

.char-grid {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    padding: 0 1% 10px;
}

.char-card {
    width: 22%;
    min-width: 155px;
    max-width: 300px;
    min-height: 230px;
    margin: 0 7px;
    padding: 0;
    background-color: rgb(36, 32, 43);
    border-width: 3px;
    border-color: rgb(240, 238, 232);
    border-bottom-width: 7px;
    border-bottom-color: rgb(13, 13, 20);
    transition-duration: 0.12s;
    transition-property: translate, border-color, background-color;
}

.char-card--selected {
    translate: 0 -7px;
    background-color: rgb(13, 13, 20);
    border-width: 5px;
    border-bottom-width: 8px;
    border-color: rgb(255, 204, 34);
}

.char-card:hover {
    translate: 0 -5px;
    border-color: rgb(241, 235, 221);
}
.char-card:focus {
    translate: 0 -5px;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
}
.char-card--selected:hover,
.char-card--selected:focus {
    translate: 0 -7px;
    border-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 204, 34);
}

.char-portrait {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    overflow: hidden;
    background-color: rgb(44, 40, 49);
    background-position: center;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(220, 213, 222);
}
.char-card:hover .char-portrait,
.char-card:focus .char-portrait,
.char-card--selected .char-portrait {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}


.char-card-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 56px;
    padding-left: 14px;
    padding-right: 48px;
    border-top-width: 3px;
    border-top-color: rgb(13, 13, 20);
    color: rgb(23, 19, 27);
    background-color: rgb(240, 238, 232);
    font-size: 25px;
    letter-spacing: 0;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}
.char-card--selected .char-card-name {
    color: rgb(23, 19, 27);
    background-color: rgb(255, 204, 34);
}
.char-card:hover .char-card-name,
.char-card:focus .char-card-name { color: rgb(23, 19, 27); }

.char-card-check {
    position: absolute;
    right: 14px;
    bottom: 16px;
    width: 24px;
    height: 24px;
    background-image: url("SelectionCheck.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(23, 19, 27);
    display: none;
}
.char-card--selected .char-card-check { display: flex; }

.char-markers {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.char-marker {
    margin-right: 5px;
    margin-bottom: 5px;
    padding: 5px 7px;
    color: rgb(20, 17, 24);
    background-color: rgb(255, 200, 33);
    font-size: 13px;
    -unity-font-style: bold;
}

.char-marker--selecting {
    background-color: rgb(240, 238, 232);
}

.char-marker--ready {
    background-color: rgb(76, 221, 136);
}

.char-marker--local {
    border-width: 2px;
    border-color: rgb(240, 238, 232);
    background-color: rgb(23, 19, 27);
    color: rgb(240, 238, 232);
    -unity-font-definition: url("../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
}

.selection-copy {
    min-height: 53px;
    align-items: center;
    justify-content: center;
}

.char-name {
    color: rgb(240, 238, 232);
    font-size: 32px;
    letter-spacing: 1px;
}

.char-role {
    margin-top: 3px;
    color: rgb(196, 189, 197);
    font-size: 18px;
    white-space: normal;
}

.pvp-panel {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 5%;
    min-height: 190px;
    flex-direction: row;
    align-items: stretch;
    display: none;
}

.player-cards-area {
    flex-grow: 0;
    width: auto;
    min-width: 0;
    justify-content: flex-start;
}

.roster-panel {
    width: auto;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
}

.player-card {
    width: 172px;
    min-height: 174px;
    margin-right: 10px;
    padding: 11px;
    flex-shrink: 0;
    background-color: rgb(35, 30, 40);
    border-width: 2px;
    border-color: rgb(83, 77, 91);
    border-bottom-width: 5px;
    border-bottom-color: rgb(224, 92, 42);
}

.player-card--local {
    border-color: rgb(255, 200, 33);
    border-bottom-color: rgb(255, 200, 33);
}
.player-card--editing {
    border-width: 3px;
    border-color: rgb(240, 238, 232);
    border-bottom-width: 6px;
    border-bottom-color: rgb(255, 200, 33);
    background-color: rgb(52, 45, 55);
}


.player-card__identity {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.player-card__number {
    color: rgb(255, 200, 33);
    font-size: 18px;
    -unity-font-style: bold;
}

.player-card__host {
    color: rgb(183, 174, 184);
    font-size: 13px;
    letter-spacing: 1px;
}

.player-card__name {
    margin-top: 3px;
    color: rgb(240, 238, 232);
    font-size: 17px;
    -unity-font-style: bold;
}

.player-card__portrait {
    position: relative;
    align-self: flex-end;
    width: 62px;
    height: 62px;
    margin-top: 6px;
    background-color: rgb(44, 40, 49);
    -unity-background-scale-mode: scale-and-crop;
}
.player-card__character {
    margin-top: 7px;
    color: rgb(240, 238, 232);
    font-size: 17px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.player-card__waiting {
    flex-grow: 1;
    margin-top: 18px;
    color: rgb(183, 174, 184);
    font-size: 15px;
    white-space: normal;
}

.player-card__status {
    margin-top: 10px;
    max-width: 100%;
    color: rgb(240, 238, 232);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.player-card__status--locked {
    color: rgb(76, 221, 136);
}

.player-card__status--picking {
    color: rgb(255, 200, 33);
}
.player-card__status--editing {
    color: rgb(255, 200, 33);
}


.solo-config {
    width: 440px;
    min-width: 440px;
    margin-left: 10px;
    padding: 16px 18px;
    background-color: rgb(240, 238, 232);
    border-width: 3px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 7px;
    border-right-width: 6px;
    align-items: stretch;
    display: none;
}

.selection-target {
    color: rgb(23, 19, 27);
    font-size: 21px;
    letter-spacing: 0;
    -unity-font-style: bold;
}

.selection-target-buttons {
    margin-top: 12px;
    flex-direction: row;
}

.selection-target-button {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    min-height: 42px;
    padding-left: 5px;
    padding-right: 5px;
    background-color: rgb(240, 238, 232);
    color: rgb(23, 19, 27);
    border-width: 2px;
    border-color: rgb(23, 19, 27);
    border-bottom-width: 6px;
    border-right-width: 4px;
    font-size: 15px;
}
#btn-edit-player { margin-right: 6px; }
.selection-target-button:hover,
.selection-target-button:focus {
    background-color: rgb(255, 255, 255);
    border-color: rgb(23, 19, 27);
    translate: 0 -2px;
}
.selection-target-button.active {
    background-color: rgb(255, 204, 34);
    border-color: rgb(23, 19, 27);
    color: rgb(23, 19, 27);
}
.selection-target-button.active:hover,
.selection-target-button.active:focus {
    background-color: rgb(255, 218, 74);
    border-color: rgb(23, 19, 27);
}
.selection-target-button:active {
    translate: 0 3px;
}

.solo-difficulty-buttons {
    width: 100%;
    margin-top: 12px;
    flex-direction: row;
}
.solo-difficulty-button {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    min-height: 42px;
    margin-right: 5px;
    padding-left: 3px;
    padding-right: 3px;
    background-color: rgb(240, 238, 232);
    border-color: rgb(23, 19, 27);
    color: rgb(23, 19, 27);
    font-size: 14px;
    letter-spacing: 0;
}
#btn-cpu-difficulty-hard { margin-right: 0; }
.solo-difficulty-button:hover,
.solo-difficulty-button:focus {
    background-color: rgb(255, 255, 255);
    border-color: rgb(23, 19, 27);
    color: rgb(23, 19, 27);
}
.solo-difficulty-button.active {
    background-color: rgb(255, 204, 34);
    border-color: rgb(23, 19, 27);
    color: rgb(23, 19, 27);
}
.solo-difficulty-button.active:hover,
.solo-difficulty-button.active:focus {
    background-color: rgb(255, 218, 74);
    border-color: rgb(23, 19, 27);
}

.pvp-action-area {
    width: 220px;
    min-width: 220px;
    margin-left: 10px;
    align-items: stretch;
}

.frontend-shell .pvp-status {
    margin-bottom: 8px;
    color: var(--shell-page-ink);
    font-size: 16px;
    white-space: normal;
}

.pvp-buttons {
    flex-direction: column;
    align-items: stretch;
}

.pvp-btn {
    width: 100%;
    min-height: 49px;
    margin-top: 7px;
    font-size: 16px;
}

.solo-next-action {
    width: 190px;
    min-width: 190px;
    margin-left: 10px;
    align-items: stretch;
    justify-content: flex-end;
}

.solo-next-action > .btn-primary {
    width: 100%;
    min-height: 57px;
}



.results-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: var(--shell-canvas);
}

.results-header-copy {
    flex-direction: column;
    align-items: flex-start;
}

.results-headline {
    color: rgb(240, 238, 232);
    font-size: 48px;
    letter-spacing: -1px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
}

.frontend-shell .results-stage {
    margin-top: 10px;
    color: var(--shell-page-ink);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.frontend-shell .results-metadata {
    margin-top: 8px;
    padding: 8px 12px;
    background-color: transparent;
    color: var(--shell-page-muted);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/SpaceMono.asset");
}

.results-metadata {
    margin-top: 8px;
    padding: 8px 12px;
    background-color: var(--shell-surface);
    color: var(--shell-paper);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/SpaceMono.asset");
}

.results-content {
    flex-grow: 1;
    min-width: 0;
    position: relative;
    flex-direction: row;
}

.results-winner {
    width: 57%;
    min-width: 0;
    margin-right: 18px;
}

.results-winner-card {
    position: relative;
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
    background-color: var(--shell-paper);
    border-width: 3px;
    border-color: var(--shell-canvas);
    border-left-width: 8px;
    border-bottom-width: 8px;
    translate: -36px 0;
    opacity: 0;
    transition-duration: 0.28s;
    transition-property: translate, opacity;
}

.results-ready .results-winner-card {
    translate: 0 0;
    opacity: 1;
}

.results-winner-placement {
    position: absolute;
    left: 24px;
    top: 16px;
    color: var(--shell-surface);
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
}

.results-winner-label {
    position: absolute;
    left: 24px;
    top: 48px;
    color: var(--shell-canvas);
    font-size: 28px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
}

.results-winner-portrait {
    width: 35%;
    height: 100%;
    margin-left: auto;
    margin-right: 0;
    background-color: var(--shell-surface);
    -unity-background-scale-mode: scale-and-crop;
}

.results-winner-copy {
    position: absolute;
    left: 24px;
    right: 36%;
    bottom: 20px;
    align-items: flex-start;
}

.results-winner-player {
    color: var(--shell-canvas);
    font-size: 40px;
    letter-spacing: 0;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    white-space: nowrap;
    overflow: hidden;
    max-width: 100%;
    min-width: 0;
    text-overflow: ellipsis;
}

.frontend-shell .results-winner-fighter {
    margin-top: 4px;
    color: var(--shell-canvas);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.results-winner-stats {
    flex-direction: row;
    margin-top: 16px;
}

.results-stat {
    min-width: 64px;
    margin-right: 16px;
    padding-top: 6px;
    border-top-width: 2px;
    border-top-color: var(--shell-rule);
}

.results-stat-value {
    color: var(--shell-canvas);
    font-size: 22px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
}

.results-stat-label {
    margin-top: 2px;
    color: var(--shell-surface);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/SpaceMono.asset");
}

.results-standings {
    flex-grow: 1;
    min-width: 0;
    padding-left: 0;
    flex-direction: column;
    align-items: stretch;
}

.results-standings-label {
    height: 30px;
    padding: 8px 10px;
    background-color: var(--shell-surface);
    color: var(--shell-paper);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.results-player-row {
    min-height: 82px;
    margin-top: 7px;
    padding: 8px 12px;
    flex-direction: row;
    align-items: center;
    background-color: var(--shell-paper);
    border-width: 2px;
    border-color: var(--shell-canvas);
    border-left-width: 6px;
    border-bottom-width: 5px;
    translate: 30px 0;
    opacity: 0;
    transition-duration: 0.22s;
    transition-property: translate, opacity;
}

.results-ready .results-player-row {
    translate: 0 0;
    opacity: 1;
}

.results-row-placement {
    width: 38px;
    color: var(--shell-canvas);
    font-size: 20px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
}

.results-row-portrait {
    width: 54px;
    height: 62px;
    background-color: var(--shell-surface);
    -unity-background-scale-mode: scale-and-crop;
}

.results-row-identity {
    flex-grow: 1;
    min-width: 0;
    margin-left: 12px;
    align-items: flex-start;
}

.results-row-player {
    color: var(--shell-canvas);
    font-size: 14px;
    letter-spacing: 0;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    white-space: nowrap;
    overflow: hidden;
    max-width: 100%;
    text-overflow: ellipsis;
}

.results-row-fighter {
    margin-top: 4px;
    color: var(--shell-surface);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.results-row-stats {
    flex-direction: row;
    align-items: center;
}

.results-row-stats .results-stat {
    min-width: 42px;
    margin-right: 8px;
    padding-top: 4px;
}

.results-row-stats .results-stat-value {
    font-size: 17px;
}

.results-row-stats .results-stat-label {
    font-size: 11px;
}

.results-actions {
    flex-grow: 1;
    min-width: 0;
    align-items: flex-end;
    justify-content: flex-end;
    opacity: 0;
    translate: 0 18px;
    transition-duration: 0.22s;
    transition-property: opacity, translate;
}

.results-actions.results-ready {
    opacity: 1;
    translate: 0 0;
}

.results-return {
    width: 260px;
    height: 52px;
    padding: 0 16px;
    border-radius: 0;
    border-width: 3px;
    border-color: var(--shell-canvas);
    border-bottom-width: 6px;
    border-right-width: 5px;
    background-color: var(--shell-action);
    color: var(--shell-canvas);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-center;
}

.results-return:hover,
.results-return:focus {
    background-color: var(--shell-paper);
    border-color: var(--shell-canvas);
}

.results-return:focus {
    border-color: var(--shell-action);
}

.results-return:active {
    translate: 0 3px;
    border-bottom-width: 3px;
    border-right-width: 3px;
}

.results-return:disabled {
    background-color: var(--shell-surface);
    color: var(--shell-paper);
    border-color: var(--shell-rule);
    opacity: 0.72;
}

.results-count-2 .results-winner {
    width: 62%;
}

.results-count-2 .results-player-row {
    min-height: 105px;
}

.results-count-3 .results-player-row,
.results-count-4 .results-player-row {
    min-height: 72px;
}

.results-count-3 .results-row-portrait,
.results-count-4 .results-row-portrait {
    width: 46px;
    height: 52px;
}

/* Page color roles do not raise the specificity of geometry rules above. */
.frontend-shell .flow-title,
.frontend-shell .char-name,
.frontend-shell .char-role,
.frontend-shell .results-headline {
    color: var(--shell-page-ink);
}
.frontend-shell .flow-subtitle { color: var(--shell-page-muted); }

.frontend-shell .browser-panel .browser-hint { color: var(--shell-paper); }
