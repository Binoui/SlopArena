<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SlopArena.uss?fileID=7433441132597879392&amp;guid=a41ba556d3415bfd586226903c56f69e&amp;type=3#SlopArena" />
    <ui:VisualElement name="root" class="screen" style="background-image: none;">
        <ui:Label name="title" text="LOBBY" class="title" />
        <ui:VisualElement name="players" class="player-list">
            <ui:VisualElement name="p1-row" class="player-row">
                <ui:Label name="p1-label" text="P1" class="player-id" />
                <ui:Label name="p1-status" text="Connected" class="player-status player-status--connected" />
            </ui:VisualElement>
            <ui:VisualElement name="p2-row" class="player-row unity-last-child">
                <ui:Label name="p2-label" text="P2" class="player-id" />
                <ui:Label name="p2-status" text="Waiting..." class="player-status player-status--waiting" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="btn-start" text="START" class="btn-primary" style="display: none;" />
        <ui:Label name="lbl-waiting" text="Waiting for host to start..." class="subtitle" style="display: none;" />
        <ui:Button name="btn-back" text="← BACK" class="btn-back" />
        <ui:VisualElement name="global-chat" class="global-chat">
            <ui:VisualElement class="global-chat__header">
                <ui:Label text="GLOBAL CHAT" class="global-chat__title" />
                <ui:Label text="1,204 ONLINE" class="global-chat__online" />
            </ui:VisualElement>
            <ui:VisualElement name="chat-feed" class="global-chat__feed">
                <ui:Label text="BonkLord: gg wp anyone up for 2v2?" class="global-chat__message" />
                <ui:Label text="slopqueen: waiting on P2" class="global-chat__message global-chat__message--accent" />
                <ui:Label text="dude420: host is up, join fast" class="global-chat__message global-chat__message--hot" />
            </ui:VisualElement>
            <ui:VisualElement class="global-chat__input-row">
                <ui:TextField name="chat-input" placeholdertext="type here…" class="global-chat__input" />
                <ui:Button name="chat-send" text="➜" class="global-chat__send" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
