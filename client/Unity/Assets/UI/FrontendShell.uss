/* FrontendShell (issues #218/#219): the permanent frontend frame. One stable
   document: top bar, page header/body hosts, lower row with social and
   page summary/actions cells, plus expanded-social and modal hosts. Home
   overlays its social cell instead of reserving layout space. Density classes
   live on the stable shell root; PanelSettings use ConstantPhysicalSize
   (96 dpi), so USS px ≈ physical pixels. */

.frontend-shell {
    flex-grow: 1;
    color: rgb(240, 238, 232);
    font-size: 18px;
    background-color: rgb(23, 19, 27);
}

.shell-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(23, 19, 27);
    border-right-width: 14px;
    border-right-color: rgb(224, 92, 42);
    -unity-text-align: middle-left;
}

.frontend-shell--home,
.frontend-shell--home .shell-backdrop {
    background-color: rgb(21, 18, 25);
    color: rgb(241, 235, 221);
}

.frontend-shell--home .shell-backdrop {
    border-right-color: rgb(255, 204, 34);
}

.shell-hidden {
    display: none;
}

/* ── Shell modal host (issue #220) ─────────────────────────────────────
   The host stays visible but empty while no modal is presented: it paints
   nothing and ignores picking, so an empty host is invisible. The identity
   view presents its modal here; presenting suppresses unread
   acknowledgement through UiModalState. */

.shell-modal-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.shell-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 20, 0.55);
}

.shell-modal-box {
    min-width: 420px;
    max-width: 560px;
    padding: 20px 24px;
    background-color: rgb(23, 19, 27);
    border-width: 2px;
    border-color: rgb(255, 200, 33);
}

.shell-modal-title {
    color: rgb(255, 200, 33);
    font-size: 16px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.shell-modal-help {
    margin-top: 8px;
    margin-bottom: 14px;
    color: rgb(196, 189, 197);
    font-size: 13px;
    white-space: normal;
}

.shell-modal-row {
    flex-direction: row;
    align-items: stretch;
}

.shell-modal-field {
    flex-grow: 1;
    min-width: 0;
    min-height: 36px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: rgb(98, 92, 107);
    background-color: rgb(240, 238, 232);
    color: rgb(23, 19, 27);
    font-size: 13px;
}

.shell-modal-field:focus {
    border-color: rgb(255, 200, 33);
}

.shell-modal-submit {
    min-width: 140px;
    min-height: 36px;
    margin-left: 8px;
    border-width: 2px;
    border-color: rgb(13, 13, 20);
    border-bottom-width: 4px;
    background-color: rgb(255, 200, 33);
    color: rgb(23, 19, 27);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.shell-modal-feedback {
    min-height: 18px;
    margin-top: 8px;
    color: rgb(175, 168, 178);
    font-size: 12px;
    white-space: normal;
}

/* The frontend-wide pause menu shares the shell's square, printed controls. */
.shell-escape-menu {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 20, 0.78);
}

.shell-escape-menu--open {
    display: flex;
}

.shell-escape-card {
    width: 360px;
    max-width: 90%;
    padding: 24px;
    background-color: rgb(23, 19, 27);
    border-width: 2px;
    border-color: rgb(255, 200, 33);
    border-bottom-width: 7px;
}

.shell-escape-title {
    margin-bottom: 18px;
    color: rgb(255, 200, 33);
    font-size: 36px;
    -unity-font-definition: url("../Fonts/Baloo2.asset");
    -unity-font-style: bold;
}

.shell-escape-action {
    width: 100%;
    margin-bottom: 10px;
}


.shell-escape-action.btn-back {
    width: 100%;
    font-size: 18px;
}

.shell-menu-trigger {
    min-width: 92px;
    min-height: 40px;
    margin-left: 12px;
    padding-left: 32px;
    padding-right: 10px;
    background-color: rgb(36, 32, 43);
    border-width: 1px;
    border-color: rgb(66, 59, 73);
    color: rgb(241, 235, 221);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.shell-menu-trigger:hover,
.shell-menu-trigger:focus {
    border-color: rgb(255, 204, 34);
    color: rgb(255, 204, 34);
}

.shell-menu-gear {
    position: absolute;
    left: 9px;
    top: 9px;
    width: 20px;
    height: 20px;
    background-image: url("MenuGear.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Keep the bottom action visible in shorter desktop windows. */
.frontend-shell--compact .shell-escape-card {
    padding: 16px;
}

.frontend-shell--compact .shell-escape-action {
    min-height: 44px;
}


/* ── Top bar ──────────────────────────────────────────────────────────── */

.shell-top-bar {
    height: 64px;
    min-height: 64px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 2px;
    border-bottom-color: rgb(66, 59, 73);
}

.shell-wordmark {
    min-height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: rgb(255, 204, 34);
    background-color: rgb(255, 204, 34);
    color: rgb(21, 18, 25);
    font-size: 22px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/Baloo2.asset");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.shell-wordmark:hover,
.shell-wordmark:focus {
    background-color: rgb(255, 218, 74);
    border-color: rgb(241, 235, 221);
}

.shell-nav {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 18px;
}

.shell-nav-tab {
    min-width: 104px;
    min-height: 42px;
    margin-right: 4px;
    padding-left: 14px;
    padding-right: 14px;
    border-width: 1px;
    border-color: transparent;
    background-color: transparent;
    color: rgb(241, 235, 221);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.shell-nav-underline {
    position: absolute;
    bottom: 3px;
    left: 50%;
    margin-left: -16px;
    width: 32px;
    height: 3px;
    background-color: transparent;
}

.shell-nav-tab--selected {
    color: rgb(255, 204, 34);
}

.shell-nav-tab--selected .shell-nav-underline {
    background-color: rgb(255, 204, 34);
}

.shell-nav-tab:hover,
.shell-nav-tab:focus {
    color: rgb(255, 204, 34);
    border-color: rgb(66, 59, 73);
    background-color: rgb(36, 32, 43);
}

.shell-nav-tab:focus { border-color: rgb(255, 204, 34); }
.shell-nav-tab:disabled { opacity: 0.68; }

.shell-settings {
    min-height: 36px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(36, 32, 43);
    color: rgb(241, 235, 221);
    border-width: 1px;
    border-color: rgb(66, 59, 73);
    font-size: 12px;
    -unity-font-style: bold;
}

.shell-settings:hover,
.shell-settings:focus {
    border-color: rgb(255, 204, 34);
    color: rgb(255, 204, 34);
}

.shell-page-context {
    margin-left: 20px;
    color: rgb(196, 189, 197);
    font-size: 13px;
    letter-spacing: 2px;
}

.shell-top-bar-spacer {
    flex-grow: 1;
}

.shell-identity {
    margin-left: 12px;
    padding-left: 10px;
    padding-right: 10px;
    min-height: 30px;
    border-width: 1px;
    border-color: rgb(66, 59, 73);
    background-color: rgb(36, 32, 43);
    color: rgb(171, 163, 178);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.shell-identity--connected { color: rgb(76, 221, 136); }
.shell-identity--warning { color: rgb(255, 204, 34); }

.shell-identity:hover,
.shell-identity:focus {
    border-color: rgb(255, 204, 34);
}

/* The visible top-bar route (issue #220): text is set by the focus router
   ("E/X // TOP BAR"); hidden while a text field is editing or a modal is
   presented. */
.shell-topbar-hint {
    margin-right: 12px;
    color: rgb(196, 189, 197);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    white-space: nowrap;
}


/* ── Workspace and page hosts ─────────────────────────────────────────── */

.shell-workspace {
    flex-grow: 1;
    min-height: 0;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    flex-direction: column;
    /* Positioned so the expanded social surface can resolve its absolute
       geometry against the workspace below the top bar (issue #220). */
    position: relative;
}

/* Home art keeps its native 1438×810 size, centered without enlarging. */
.frontend-shell--home .shell-workspace {
    background-color: rgb(21, 18, 25);
    background-image: url("MainMenuBackground.png");
    background-size: 1438px 810px;
    background-position: center;
    background-repeat: no-repeat;
}

.shell-host {
    min-width: 0;
    min-height: 0;
}

.shell-header-host {
    flex-shrink: 0;
}

.shell-body-host {
    flex-grow: 1;
    overflow: hidden;
}

.shell-lower-row {
    flex-shrink: 0;
    margin-top: 16px;
    padding-bottom: 24px;
    flex-direction: row;
    align-items: flex-end;
}

/* Other pages reserve a bottom-left conversation cell in the lower row;
   Home positions that row over the page. The row has no painted surface. */
.shell-social-host {
    width: 480px;
    height: 230px;
    margin-right: 20px;
    position: relative;
}

.shell-page-lower-host {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    align-self: stretch;
}

.shell-summary-host {
    flex-grow: 1;
    overflow: hidden;
}

.shell-actions-host {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
}

/* ── Compact density (1280×720/800-class windows) ────────────────────── */

.frontend-shell--compact .shell-top-bar {
    height: 56px;
    min-height: 56px;
    padding-left: 16px;
    padding-right: 16px;
}

.frontend-shell--compact .shell-wordmark {
    font-size: 16px;
}

.frontend-shell--compact .shell-page-context { display: none; }
.frontend-shell--compact .shell-nav { margin-left: 10px; }
.frontend-shell--compact .shell-nav-tab {
    min-width: 70px;
    min-height: 36px;
    margin-right: 2px;
    padding-left: 6px;
    padding-right: 6px;
    font-size: 10px;
}
.frontend-shell--compact .shell-settings {
    min-height: 32px;
    margin-left: 4px;
    padding-left: 7px;
    padding-right: 7px;
    font-size: 10px;
}
.frontend-shell--compact .shell-identity {
    max-width: 160px;
    margin-left: 6px;
    font-size: 10px;
    text-overflow: ellipsis;
    overflow: hidden;
}
.frontend-shell--compact .shell-menu-trigger {
    min-width: 76px;
    min-height: 34px;
    margin-left: 6px;
    padding-left: 27px;
    padding-right: 6px;
    font-size: 10px;
}

.frontend-shell--compact .shell-workspace {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
}

.frontend-shell--compact .shell-social-host {
    width: 380px;
    height: 190px;
    margin-right: 16px;
}

.frontend-shell--compact .shell-lower-row {
    margin-top: 10px;
    padding-bottom: 16px;
}

/* Home overlays chat; other pages keep their reserved lower-row layout. */
.frontend-shell--home .shell-lower-row {
    position: absolute;
    left: 24px;
    bottom: 24px;
    margin-top: 0;
    padding-bottom: 0;
}
.frontend-shell--home .shell-page-lower-host { display: none; }
.frontend-shell--home.frontend-shell--compact .shell-lower-row {
    left: 16px;
    bottom: 16px;
}
/* Expanded chat still fills the workspace below the unchanged top bar. */
.frontend-shell--home.frontend-shell--social-expanded .shell-lower-row {
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* ── Presenter sizing inside the reserved cell ─────────────────────────
   The chat presenter keeps its own stylesheet. The shell cell's size, the
   top bar height and the outer spacing are applied from
   `FrontendShellView` in panel coordinates derived from the physical size
   targets (PanelSettings use ConstantPhysicalSize, and the runtime scale
   factor is read from `panel.scaledPixelsPerPoint`, so USS px cannot express
   physical pixels). Shell chat history may shrink and scroll when its header
   grows, so the composer remains inside the reserved cell. */

.frontend-shell .chat-panel {
    padding: 8px;
}

.frontend-shell .chat-tabs {
    height: 24px;
    margin-top: 4px;
}

.frontend-shell .chat-tab {
    min-height: 20px;
}

.frontend-shell .chat-body {
    margin-top: 4px;
}

.frontend-shell .chat-compose {
    min-height: 28px;
    margin-top: 4px;
}

.frontend-shell .chat-draft,
.frontend-shell .chat-compose .chat-action {
    min-height: 26px;
}

.frontend-shell .chat-feedback {
    min-height: 0;
}

.frontend-shell .chat-history {
    min-height: 0;
}


.frontend-shell--compact .chat-corner-actions { right: 24px; }


.frontend-shell--compact .chat-tab {
    font-size: 9px;
}


.frontend-shell--compact .conversation-list {
    width: 104px;
    min-width: 104px;
    margin-right: 6px;
}

.frontend-shell--compact .chat-message {
    min-height: 0;
    margin-bottom: 2px;
    padding: 2px 2px;
}

.frontend-shell--compact .chat-message__text {
    font-size: 11px;
}


.frontend-shell--compact .chat-draft {
    font-size: 12px;
}

.frontend-shell--compact .chat-compose .chat-action {
    width: 52px;
}

.frontend-shell--compact .chat-feedback {
    font-size: 10px;
}

/* Fit the presenter inside its resizable cell: the history keeps a small
   scrolling floor and the corner controls stay reachable. */
.frontend-shell--compact .chat-corner-actions {
    flex-direction: row;
    align-items: center;
    right: 24px;
}

.frontend-shell--compact .chat-history {
    min-height: 50px;
}


/* ── Migrated page fragments ────────────────────────────────────────────
   Mounted sections keep their existing element-scoped styles from
   SlopArena.uss; only their former viewport-wide placement is replaced
   here. */

.page-section {
    min-width: 0;
    min-height: 0;
}

/* Home */


/* Repeated fighter and setup sections keep their intended size. */
.char-body-section .selection-copy,
.char-summary-section,
.char-actions-section {
    flex-shrink: 0;
}


.menu-body-section {
    flex-grow: 1;
    min-height: 0;
    margin-top: 12px;
}

.menu-layout {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
}

.menu-actions {
    width: 330px;
    flex-shrink: 0;
    margin-top: 84px;
}

.menu-action {
    width: 100%;
    min-height: 88px;
    margin-bottom: 12px;
    padding-left: 28px;
    padding-right: 28px;
    border-radius: 0;
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: rgb(66, 59, 73);
    color: rgb(241, 235, 221);
    font-size: 27px;
    -unity-font-definition: url("../Fonts/Baloo2.asset");
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.menu-action--online {
    background-color: rgb(255, 204, 34);
    color: rgb(21, 18, 25);
}

.menu-action--solo,
.menu-action--training { background-color: rgb(36, 32, 43); }

.menu-action--online:hover,
.menu-action--online:focus {
    background-color: rgb(255, 218, 74);
    border-color: rgb(241, 235, 221);
}

.menu-action--solo:hover,
.menu-action--solo:focus,
.menu-action--training:hover,
.menu-action--training:focus {
    background-color: rgb(55, 49, 62);
    border-color: rgb(255, 204, 34);
}

.menu-action:disabled,
.menu-action:disabled:hover,
.menu-action:disabled:focus {
    background-color: rgb(36, 32, 43);
    border-color: rgb(66, 59, 73);
    color: rgb(171, 163, 178);
    opacity: 0.65;
}

.menu-info {
    width: 348px;
    height: 300px;
    flex-shrink: 0;
    padding: 22px 24px;
    background-color: rgb(36, 32, 43);
    border-width: 2px;
    border-color: rgb(66, 59, 73);
    border-bottom-width: 5px;
}

.menu-info-heading {
    color: rgb(255, 204, 34);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.menu-announcements {
    flex-grow: 1;
    min-height: 0;
    margin-top: 18px;
}

.menu-info-declaration {
    color: rgb(241, 235, 221);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-font-definition: url("../Fonts/Baloo2.asset");
    white-space: normal;
}

.menu-info-copy {
    margin-top: 12px;
    color: rgb(241, 235, 221);
    font-size: 16px;
    white-space: normal;
}

.frontend-shell--compact .menu-actions {
    width: 270px;
    margin-top: 18px;
}
.frontend-shell--compact .menu-action {
    min-height: 70px;
    margin-bottom: 8px;
    font-size: 22px;
}
.frontend-shell--compact .menu-info {
    width: 270px;
    height: 260px;
    padding: 18px 22px;
}
.frontend-shell--compact .menu-info-declaration { font-size: 22px; }
.frontend-shell--compact .menu-info-copy { font-size: 14px; }


/* Fighter Select */

/* Fragment roots are split across shell hosts. Solo and Training share
   the same title-only header instead of styling a discarded wrapper. */
.char-header--local {
    min-height: 64px;
    flex-direction: row;
    align-items: flex-start;
}
.char-header--local .flow-header-copy {
    width: 65%;
    min-width: 0;
    margin-left: 16px;
    align-items: flex-start;
}
.char-header--local .flow-eyebrow,
.char-header--local .flow-subtitle { display: none; }
.char-header--local .flow-title {
    margin-top: 0;
    font-size: 44px;
    white-space: normal;
}
.frontend-shell--compact .char-header--local .flow-title { font-size: 32px; }

.char-body-section {
    flex-grow: 1;
    margin-top: 10px;
    flex-direction: column;
    overflow: auto;
}

/* Portrait cards shrink to the frame's grid area instead of the legacy
   230px minimum (SlopArena.uss); the body scrolls only when still too
   tight, with the primary action always reachable (issue #219). */
.char-body-section .char-card {
    min-height: 170px;
    max-width: 340px;
}
.char-body-section .char-grid {
    flex-grow: 1;
    min-height: 170px;
}

.char-body-section .selection-copy {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-height: 42px;
}

.frontend-shell--compact .char-body-section .char-card,
.frontend-shell--compact .char-body-section .char-grid {
    min-height: 135px;
}


.char-summary-section {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
}

.char-summary-section .roster-panel {
    flex-direction: row;
    align-items: stretch;
}

/* Local fighter selection keeps step/status and continuation beside the
   participant controls; the one-player Training card gets its own width. */
.char-summary-section--local {
    align-items: flex-start;
}

.char-summary-section--solo .player-card {
    flex-direction: column;
    align-items: stretch;
    background-color: rgb(36, 32, 43);
    border-color: rgb(66, 59, 73);
    border-bottom-color: rgb(66, 59, 73);
}
.char-summary-section--solo .player-card__number {
    color: rgb(171, 163, 178);
}
.char-summary-section--solo .player-card:hover,
.char-summary-section--solo .player-card:focus {
    border-color: rgb(241, 235, 221);
}
.char-summary-section--solo .player-card--editing {
    background-color: rgb(48, 42, 52);
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: rgb(255, 204, 34);
    border-bottom-color: rgb(255, 204, 34);
}
.char-summary-section--solo .player-card--editing .player-card__number {
    color: rgb(255, 204, 34);
}
.char-summary-section--solo .player-card--editing:hover,
.char-summary-section--solo .player-card--editing:focus {
    border-color: rgb(255, 218, 74);
    border-bottom-color: rgb(255, 204, 34);
}
.char-summary-section--local .solo-next-action {
    width: 230px;
    min-width: 0;
    margin-left: 16px;
    align-self: flex-start;
    align-items: stretch;
}
.char-summary-section--local .char-header-status {
    margin-left: 0;
    margin-bottom: 12px;
    align-items: flex-start;
}
.char-summary-section--local .char-select-meta {
    margin-top: 6px;
}

.frontend-shell--compact .char-summary-section.char-summary-section--local .solo-next-action {
    width: 200px;
    min-width: 0;
}

.frontend-shell--compact .char-summary-section .roster-panel .player-card {
    width: 140px;
    min-height: 110px;
}

.frontend-shell--compact .solo-config {
    width: 300px;
    min-width: 300px;
}

.char-actions-section {
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    margin-left: 10px;
}

.frontend-shell--compact .pvp-action-area {
    width: 170px;
    min-width: 170px;
}

.frontend-shell--compact .solo-next-action {
    width: 220px;
    min-width: 220px;
}

.frontend-shell--compact .solo-next-action > .btn-primary {
    min-height: 44px;
}

.frontend-shell--compact .btn-back {
    width: 84px;
    min-height: 40px;
}

/* ── Stage Select fragment (issue #221) ────────────────────────────────
   Stage cards lead; participants and the primary action share the
   lower-right row beside the persistent social cell. */
.frontend-shell--stage .shell-page-lower-host {
    flex-direction: row;
    align-items: flex-end;
}

.frontend-shell--stage .shell-summary-host {
    flex-grow: 1;
    min-width: 0;
}

.frontend-shell--stage .shell-actions-host {
    flex-shrink: 0;
}


.stage-header-section {
    flex-shrink: 0;
    min-height: 72px;
    flex-direction: row;
    align-items: flex-start;
}

.stage-header-section .flow-header-copy {
    margin-left: 16px;
    align-items: flex-start;
}

.stage-header-section .flow-title {
    font-size: 34px;
    margin-top: 2px;
}

.stage-header-section .flow-subtitle {
    margin-top: 4px;
    font-size: 15px;
}

.stage-header-section .stage-host-status {
    margin-top: 6px;
    font-size: 13px;
}

.stage-body-section {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
}

.stage-body-section .stage-scroll {
    flex-grow: 1;
    min-height: 0;
}
.stage-body-section .stage-grid {
    width: 100%;
}

.stage-body-section .stage-card {
    height: 170px;
}


.stage-summary-section {
    flex-shrink: 0;
    margin-top: 10px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
}

.stage-summary-section .stage-player-cards {
    flex-direction: row;
    align-items: stretch;
    margin-right: 12px;
}

.stage-actions-section {
    flex-shrink: 0;
    width: 260px;
    min-width: 260px;
    padding: 12px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    background-color: rgb(13, 13, 20);
    border-width: 2px;
    border-color: rgb(240, 238, 232);
    border-bottom-width: 6px;
    border-bottom-color: rgb(255, 200, 33);
}

.frontend-shell--compact .stage-header-section {
    min-height: 56px;
}

.frontend-shell--compact .stage-header-section .flow-title {
    font-size: 26px;
}

.frontend-shell--compact .stage-header-section .flow-eyebrow,
.frontend-shell--compact .stage-header-section .flow-subtitle {
    display: none;
}

.frontend-shell--compact .stage-body-section .stage-card {
    width: 18%;
    height: 124px;
}


.frontend-shell--compact .stage-summary-section .stage-player-cards .player-card {
    width: 120px;
    min-height: 110px;
    margin-right: 4px;
}

.frontend-shell--compact .stage-actions-section {
    width: 220px;
    min-width: 220px;
}

/* ── Server Browser fragment (issue #221) ──────────────────────────────
   Room list plus the compact hosting/address tools in the body; connection
   and operation feedback in the lower-right summary; the host/join actions
   outside the conversation cell. The direct-connect form opens from the
   page-modal section in the shell modal host. */

.browser-header-section {
    flex-shrink: 0;
    min-height: 72px;
    flex-direction: row;
    align-items: flex-start;
}

.browser-header-section .flow-header-copy {
    margin-left: 16px;
    align-items: flex-start;
}

.browser-header-section .flow-title {
    font-size: 34px;
    margin-top: 2px;
}

.browser-header-section .flow-subtitle {
    margin-top: 4px;
    font-size: 15px;
}

.browser-body-section {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
}

.browser-body-section .browser-panel {
    flex-grow: 1;
    flex-direction: column;
}
.browser-body-section .browser-tools {
    width: 420px;
}


.browser-summary-section {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
}

.browser-summary-section .host-status {
    color: rgb(240, 238, 232);
}

.browser-actions-section {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
}

.browser-actions-section .btn-hot,
.browser-actions-section .btn-secondary {
    width: 210px;
    min-height: 48px;
}

.browser-actions-section .btn-secondary {
    margin-left: 10px;
}

.browser-actions-section .host-cancel {
    margin-left: 0;
}

/* The page-modal section lives in the shell modal host; the direct-connect
   form keeps its absolute full-cover backdrop there. */
.frontend-shell--compact .direct-connect-card {
    max-width: 92%;
}

.frontend-shell--compact .browser-header-section {
    min-height: 56px;
}

.frontend-shell--compact .browser-header-section .flow-title {
    font-size: 26px;
}

.frontend-shell--compact .browser-header-section .flow-subtitle {
    font-size: 13px;
}

.frontend-shell--compact .browser-body-section .browser-layout {
    flex-direction: row;
    overflow: hidden;
}

.frontend-shell--compact .browser-body-section .browser-tools {
    width: 300px;
    min-width: 300px;
    margin-left: 12px;
    margin-top: 0;
}

.frontend-shell--compact .browser-actions-section .btn-hot,
.frontend-shell--compact .browser-actions-section .btn-secondary {
    min-height: 44px;
}

/* ── Lobby Room fragment (issue #221) ──────────────────────────────────
   Roster and room details in the body; readiness/host state in the
   lower-right summary; leave/continue controls respecting authority in
   the actions cell. */

.lobby-header-section {
    flex-shrink: 0;
    min-height: 72px;
    flex-direction: row;
    align-items: flex-start;
}

.lobby-header-section .flow-header-copy {
    margin-left: 16px;
    align-items: flex-start;
}

.lobby-header-section .flow-title {
    font-size: 34px;
    margin-top: 2px;
}

.lobby-header-section .flow-subtitle {
    margin-top: 4px;
    font-size: 15px;
}

.lobby-header-section .flow-context {
    margin-left: auto;
    align-self: flex-start;
}

.lobby-body-section {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
}

.lobby-body-section .lobby-panel {
    flex-grow: 1;
    flex-direction: column;
}

.lobby-body-section .player-list-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 12px;
}

.lobby-summary-section {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
}
.lobby-invite-hint {
    margin-top: 6px;
    color: rgb(240, 238, 232);
    font-size: 13px;
    white-space: normal;
}


.lobby-actions-section {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.lobby-actions-section .lobby-action--leave {
    margin-left: 0;
}
.lobby-action--invite:disabled {
    background-color: rgb(83, 77, 91);
    border-color: rgb(83, 77, 91);
    color: rgb(222, 216, 224);
}

.frontend-shell--compact .lobby-actions-section .lobby-action {
    width: 150px;
    min-height: 44px;
    font-size: 15px;
}

.frontend-shell--compact .lobby-actions-section .lobby-action--start {
    width: 190px;
}


.frontend-shell--compact .lobby-header-section {
    min-height: 56px;
}

.frontend-shell--compact .lobby-header-section .flow-title {
    font-size: 26px;
}

.frontend-shell--compact .lobby-header-section .flow-subtitle {
    font-size: 13px;
}

.frontend-shell--compact .lobby-body-section .player-slot {
    min-height: 54px;
}

/* ── Results fragment (issue #221) ─────────────────────────────────────
   The distinctive winner/standings broadcast composition fills the body;
   the decorative art stays inside it; the existing result context and the
   return action sit in the lower-right cells. */

.results-header-section {
    flex-shrink: 0;
    min-height: 88px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 2;
}

.results-header-section .results-headline {
    font-size: 40px;
}

.results-body-section {
    flex-grow: 1;
    min-height: 0;
    margin-top: 10px;
    position: relative;
}

.results-body-section .results-winner {
    margin-top: 4px;
}

.results-actions-section.results-actions {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
}

.frontend-shell--compact .results-header-section {
    min-height: 64px;
}

.frontend-shell--compact .results-header-section .results-headline {
    font-size: 30px;
}

.frontend-shell--compact .results-body-section {
    overflow: auto;
}

.frontend-shell--compact .results-winner-card {
    min-height: 190px;
}

.frontend-shell--compact .results-return {
    width: 220px;
    min-height: 46px;
}
