<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SlopArena.uss?fileID=7433441132597879392&amp;guid=a41ba556d3415bfd586226903c56f69e&amp;type=3#SlopArena" />
    <ui:VisualElement name="root" class="screen server-browser-screen">
        <ui:VisualElement name="backdrop" class="server-browser-backdrop" />
        <ui:VisualElement name="flow-header" class="flow-header">
            <ui:Button name="btn-back" text="BACK" class="btn-back" />
            <ui:VisualElement class="flow-header-copy">
                <ui:Label text="ONLINE PLAY" class="flow-eyebrow" />
                <ui:Label name="title" text="SERVER BROWSER" class="flow-title" />
                <ui:Label text="Find a room, or make one for the crew." class="flow-subtitle" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="browser-layout" class="browser-layout">
            <ui:VisualElement name="browser-panel" class="browser-panel">
                <ui:VisualElement class="browser-panel__header">
                    <ui:Label text="ROOMS TO JOIN" class="panel-title" />
                    <ui:Label text="PUBLIC LIST" class="panel-note" />
                </ui:VisualElement>
                <ui:Label name="lbl-status" text="Loading the room list…" class="browser-status" />
                <ui:ScrollView name="server-list" class="server-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement class="browser-panel__footer">
                    <ui:Label text="Nothing here? Refresh, host, or use an address." class="browser-hint" />
                    <ui:Button name="btn-refresh" text="REFRESH" class="btn-secondary browser-refresh" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="browser-tools" class="browser-tools">
                <ui:VisualElement name="host-panel" class="browser-tool browser-host-panel">
                    <ui:Label text="MAKE A ROOM" class="panel-title" />
                    <ui:Label text="Start the room here, then invite your friends with the address." class="tool-copy" />
                    <ui:Label text="PUBLIC ADDRESS (OPTIONAL)" class="field-label" />
                    <ui:TextField name="host-ip-field" placeholdertext="auto-detect" class="browser-input" />
                    <ui:Label text="Leave blank to advertise the server's detected address." class="field-help" />
                    <ui:Label name="lbl-host-status" class="host-status" />
                    <ui:VisualElement class="host-actions">
                        <ui:Button name="btn-host-cancel" text="CANCEL HOST" class="btn-secondary host-cancel" style="display: none;" />
                        <ui:Button name="btn-host" text="HOST MATCH" class="btn-hot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="direct-connect-panel" class="browser-tool browser-direct-panel">
                    <ui:Label text="JOIN BY ADDRESS" class="panel-title" />
                    <ui:Label text="Have a registered server address from a friend? Enter it directly." class="tool-copy" />
                    <ui:Button name="btn-direct-connect" text="JOIN BY ADDRESS" class="btn-secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="direct-connect-modal" class="direct-connect-modal" style="display: none;">
            <ui:VisualElement class="direct-connect-card">
                <ui:Label text="JOIN BY ADDRESS" class="direct-connect-title" />
                <ui:Label text="Find a registered server by its IPv4 address." class="direct-connect-copy" />
                <ui:Label text="SERVER ADDRESS" class="field-label" />
                <ui:TextField name="ip-field" value="127.0.0.1" placeholdertext="192.168.1.20:9876" class="direct-connect-input" />
                <ui:Label name="direct-connect-status" class="direct-connect-status" />
                <ui:VisualElement class="direct-connect-actions">
                    <ui:Button name="btn-modal-close" text="CANCEL" class="btn-secondary" />
                    <ui:Button name="btn-join" text="JOIN FIGHT" class="btn-hot" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>