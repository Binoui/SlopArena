<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SlopArena.uss?fileID=7433441132597879392&amp;guid=a41ba556d3415bfd586226903c56f69e&amp;type=3#SlopArena" />
    <ui:VisualElement name="root" class="results-screen">
        <ui:VisualElement class="results-background">
            <ui:VisualElement class="results-grid" />
            <ui:VisualElement class="results-burst results-burst--orange" />
            <ui:VisualElement class="results-burst results-burst--yellow" />
            <ui:Label text="SIGNAL // 07" class="results-background-note results-background-note--left" />
            <ui:Label text="LIVE FEED // POST-FIGHT" class="results-background-note results-background-note--right" />
        </ui:VisualElement>

        <ui:VisualElement name="results-header" class="results-header">
            <ui:VisualElement class="results-header-copy">
                <ui:Label text="MATCH COMPLETE" class="results-eyebrow" />
                <ui:Label name="results-headline" text="FIGHT OVER" class="results-headline" />
                <ui:Label name="results-stage" text="MATCH COMPLETE // STAGE" class="results-stage" />
            </ui:VisualElement>
            <ui:Label name="results-metadata" text="DURATION N/A // 0 PLAYERS" class="results-metadata" />
        </ui:VisualElement>

        <ui:VisualElement name="results-content" class="results-content">
            <ui:VisualElement name="results-winner" class="results-winner" />
            <ui:VisualElement name="results-standings" class="results-standings">
                <ui:Label name="results-standings-label" text="FINAL STANDINGS" class="results-standings-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="results-footer" class="results-footer">

            <ui:VisualElement name="results-actions" class="results-actions">
                <ui:Label text="NEXT BROADCAST" class="results-actions-eyebrow" />
                <ui:Label text="RUN IT BACK // CHANGE FIGHTERS" class="results-actions-future" />
                <ui:Button name="btn-return-lobby" text="RETURN TO LOBBY" class="results-return" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
