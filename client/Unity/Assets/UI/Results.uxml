<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Results page fragment (issue #221). Mounted into the FrontendShell
         hosts: outcome in PageHeaderHost, winner/standings in PageBodyHost,
         and the result context plus return action in PageActionsHost. Real
         result state lives in ResultsUI (consumes only the immutable ClientSession
         snapshot). -->
    <ui:VisualElement name="page-frag">
        <ui:VisualElement name="page-header" class="page-section results-header-section">
            <ui:VisualElement class="results-header-copy">
                <ui:Label name="results-headline" text="FIGHT OVER" class="results-headline" />
                <ui:Label name="results-stage" text="MATCH COMPLETE // STAGE" class="results-stage" />
            </ui:VisualElement>
            <ui:Label name="results-metadata" text="DURATION N/A // 0 PLAYERS" class="results-metadata" />
        </ui:VisualElement>
        <ui:VisualElement name="page-body" class="page-section results-body-section">
            <ui:VisualElement name="results-background" class="results-background" />
            <ui:VisualElement name="results-content" class="results-content">
                <ui:VisualElement name="results-winner" class="results-winner" />
                <ui:VisualElement name="results-standings" class="results-standings">
                    <ui:Label name="results-standings-label" text="FINAL STANDINGS" class="results-standings-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="page-actions" class="page-section results-actions-section results-actions">
            <ui:Button name="btn-return-lobby" text="RETURN TO LOBBY" class="results-return" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
