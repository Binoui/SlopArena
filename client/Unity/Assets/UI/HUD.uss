/* Gameplay HUD: stable match readouts, player identity, and ability feedback. */

.hud-root {
    flex-grow: 1;
    pointer-events: none;
}


.stock-toast {
    position: absolute;
    left: 18px;
    top: 198px;
    min-width: 232px;
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    display: none;
    color: #F0EEE8;
    background-color: rgba(22, 21, 19, 0.94);
    border-left-width: 5px;
    border-left-color: #7B7872;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}

.overhead-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Spatial readout: percentage only; roster color supplies identity. */
.overhead-panel {
    position: absolute;
    width: 84px;
    height: 42px;
    background-color: rgba(0, 0, 0, 0);
}

.overhead-panel.eliminated {
    opacity: 0.28;
}

.overhead-panel .overhead-damage,
.overhead-panel .overhead-damage-outline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 28px;
    letter-spacing: -1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.overhead-panel .overhead-damage-outline {
    color: #161513;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(22, 21, 19, 0.95);
}

.overhead-panel .overhead-damage {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(240, 238, 232, 0.96);
    transition-property: color, translate;
    transition-duration: 0.12s;
}

/* Multiplayer-safe left stack: one stable row per roster member. */
.player-billboard {
    position: absolute;
    left: 18px;
    right: auto;
    top: 18px;
    bottom: auto;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.billboard-card {
    position: relative;
    width: 232px;
    height: 72px;
    margin: 0;
    margin-bottom: 14px;
    overflow: visible;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(22, 21, 19, 0.93);
    border-bottom-width: 5px;
    border-bottom-color: #7B7872;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.stock-toast-player {
    position: absolute;
    left: 240px;
    top: 18px;
    min-width: 118px;
    height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    color: #F0EEE8;
    background-color: rgba(22, 21, 19, 0.94);
    border-left-width: 4px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}

.billboard-left {
    rotate: -0.6deg;
    padding-left: 66px;
    border-right-width: 2px;
    border-right-color: #7B7872;
}


.billboard-card.eliminated {
    opacity: 0.3;
}


.portrait-frame {
    position: absolute;
    width: 78px;
    height: 82px;
    bottom: -3px;
    overflow: hidden;
    background-color: #e05c2a;
}

.billboard-left .portrait-frame {
    left: -10px;
    rotate: -2deg;
}


.portrait-missing {
    opacity: 0.2;
}

.fighter-portrait {
    position: absolute;
    left: -3px;
    right: -3px;
    top: -3px;
    bottom: -3px;
    -unity-background-scale-mode: scale-to-fit;
}

.fighter-copy {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 3px 5px 3px 7px;
}

.fighter-details {
    width: 58px;
    flex-shrink: 0;
    justify-content: center;
    align-items: flex-start;
}


.fighter-tape {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin-bottom: -1px;
    background-color: #F0EEE8;
    rotate: -0.5deg;
}


.billboard-card .badge {
    min-width: 34px;
    height: 20px;
    padding: 1px 5px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #161513;
}


.fighter-name {
    margin-top: 1px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: #F0EEE8;
}




.billboard-card .overhead-damage {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    font-size: 36px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
    transition-property: color, translate;
    transition-duration: 0.12s;
}


.stock-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0 0 1px;
}


.stock-icon {
    width: 11px;
    height: 7px;
    margin: 0 1px;
    rotate: -8deg;
    background-color: #ffc821;
    border-bottom-width: 2px;
    border-bottom-color: #7B7872;
}

.stock-icon.lost {
    opacity: 0.16;
}

.stock-count {
    font-size: 11px;
    color: #f0eee8;
    -unity-font-style: bold;
}

/* Local kit: four normal slots on orange, four special slots on blue. */
.kit-diamonds {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 200px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.slot-group {
    position: relative;
    width: 200px;
    height: 200px;
    margin: 0 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.normal-diamond {
    background-image: url("HUDNormalDiamond.png");
}

.special-diamond {
    background-image: url("HUDSpecialDiamond.png");
}

.slot {
    position: absolute;
    width: 70px;
    height: 70px;
    overflow: visible;
    background-image: url("HUDSlotBase.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, translate;
    transition-duration: 0.12s;
}

.slot-top    { left: 65px; top: 14px; }
.slot-right  { left: 116px; top: 65px; }
.slot-bottom { left: 65px; top: 116px; }
.slot-left   { left: 14px; top: 65px; }

.slot.ready-pulse {
    scale: 1.1;
    translate: 0 -2px;
}

.slot.used-pulse {
    scale: 0.86;
    translate: 0 2px;
}

.slot.locked {
    opacity: 0.35;
}

.slot-content {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    overflow: hidden;
    border-radius: 50%;
}

.slot-icon-inner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #f0eee8;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.slot-flash.active {
    opacity: 0.72;
}

.slot-cooldown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    transform-origin: bottom center;
    scale: 1 1;
    background-color: rgba(22, 21, 19, 0.82);
}

.slot-timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
}

.slot-prompt {
    position: absolute;
    left: -16.75px;
    top: -12.1px;
    width: 103.5px;
    height: 32.2px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slot-prompt-image {
    display: none;
    width: 32.2px;
    height: 32.2px;
    padding: 2.3px;
    background-color: #161513;
    border-radius: 16.1px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-key-label {
    min-width: 36.8px;
    max-width: 103.5px;
    height: 21.85px;
    padding: 0 2.3px;
    font-size: 12.65px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #F0EEE8;
    background-color: #161513;
    border-radius: 11.5px;
}


/* ── Locked target readout ──────────────────────────────────────────────── */
.target-lock {
    position: absolute;
    display: none;
    width: 60px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.target-lock.visible {
    display: flex;
}

.target-lock-arrow {
    color: #EF4444;
    height: 16px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.target-lock-damage {
    color: #F0EEE8;
    height: 28px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(22, 21, 19, 0.95);
}

/* Match overlays share the frontend control language, not gameplay colors. */
.match-pause-cover {
    background-color: rgba(22, 21, 19, 0.72);
}

.match-pause-box {
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.match-pause-title {
    color: #1b1a18;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action {
    background-color: #f0eee8;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 5px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action--primary { background-color: #ffcc22; }

.match-pause-action:hover,
.match-pause-action:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.match-pause-action:active { translate: 0 3px; }

.match-pause-action:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

.shell-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.8);
}

.shell-modal-box {
    min-width: 320px;
    max-width: 560px;
    padding: 20px 24px;
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.shell-modal-title {
    color: #1b1a18;
    font-size: 24px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    white-space: normal;
}

.shell-modal-help {
    margin-top: 8px;
    margin-bottom: 14px;
    color: #252422;
    font-size: 15px;
    white-space: normal;
}

.shell-modal-row {
    flex-direction: row;
    align-items: stretch;
}

.shell-modal-submit {
    flex-grow: 1;
    min-height: 40px;
    margin-right: 6px;
    padding: 0 16px;
    background-color: #ffcc22;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.shell-modal-submit--secondary { background-color: #f0eee8; }

.shell-modal-submit:hover,
.shell-modal-submit:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.shell-modal-submit:active { translate: 0 3px; }

.shell-modal-submit:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

#steam-room-join-notice {
    background-color: rgba(22, 21, 19, 0.96);
    color: #f0eee8;
    border-width: 1px;
    border-color: #7b7872;
}
