/* Gameplay HUD: stable match readouts, player identity, and ability feedback. */

.hud-root {
    flex-grow: 1;
    pointer-events: none;
}


.stock-toast {
    position: absolute;
    left: 18px;
    top: 198px;
    min-width: 232px;
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    display: none;
    color: #F0EEE8;
    background-color: rgba(22, 21, 19, 0.94);
    border-left-width: 5px;
    border-left-color: #7B7872;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}

/* Multiplayer-safe left stack: one stable row per roster member. */
.player-billboard {
    position: absolute;
    left: 18px;
    right: auto;
    top: 18px;
    bottom: auto;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.billboard-card {
    position: relative;
    width: 308px;
    height: 102px;
    margin: 0;
    margin-bottom: 14px;
    overflow: visible;
    flex-direction: row;
    align-items: stretch;
    background-color: #1B1A18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.stock-toast-player {
    position: absolute;
    left: 316px;
    top: 18px;
    min-width: 118px;
    height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    color: #F0EEE8;
    background-color: rgba(22, 21, 19, 0.94);
    border-left-width: 4px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: opacity, translate;
    transition-duration: 0.18s;
}

.billboard-left {
    padding-left: 88px;
}


.billboard-card.eliminated .fighter-portrait {
    opacity: 0.5;
}


.portrait-frame {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 80px;
    height: 84px;
    overflow: hidden;
    border-width: 2px;
    border-color: #F0EEE8;
    background-color: #e05c2a;
}



.portrait-missing {
    opacity: 0.2;
}

.fighter-portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.fighter-copy {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    padding: 5px 10px 3px 6px;
}

.fighter-details {
    height: 22px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}


.fighter-tape {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: #F0EEE8;
}


.billboard-card .badge {
    min-width: 34px;
    height: 20px;
    padding: 1px 5px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #161513;
}


.fighter-name {
    margin-left: 8px;
    height: 22px;
    font-size: 12px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #F0EEE8;
    -unity-text-align: middle-left;
}




.billboard-card .overhead-damage {
    flex-shrink: 0;
    height: 40px;
    margin: 0;
    padding: 0;
    font-size: 38px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
    transition-property: color, translate;
    transition-duration: 0.12s;
}


.stock-row {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: #7B7872;
}

.stock-label {
    min-width: 45px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: #F0EEE8;
}

.stock-tickets {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.stock-icon {
    width: 16px;
    height: 12px;
    flex-shrink: 0;
    margin-left: 6px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #F0EEE8;
}

.stock-icon.lost {
    background-color: #1B1A18;
    border-color: #7B7872;
}

.stock-strike {
    position: absolute;
    display: none;
    left: 0;
    top: 3px;
    width: 12px;
    height: 2px;
    rotate: -35deg;
    background-color: #7B7872;
}

.stock-icon.lost .stock-strike {
    display: flex;
}

.many-stocks .stock-icon {
    width: 11px;
    height: 10px;
    margin-left: 3px;
}

.many-stocks .stock-strike {
    width: 7px;
    top: 2px;
}

.stock-count {
    min-width: 28px;
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: #F0EEE8;
    -unity-font-style: bold;
}

/* Local kit: four normal slots on orange, four special slots on blue. */
.kit-diamonds {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 200px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.slot-group {
    position: relative;
    width: 200px;
    height: 200px;
    margin: 0 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.normal-diamond {
    background-image: url("HUDNormalDiamond.png");
}

.special-diamond {
    background-image: url("HUDSpecialDiamond.png");
}

.slot {
    position: absolute;
    width: 70px;
    height: 70px;
    overflow: visible;
    background-image: url("HUDSlotBase.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, translate;
    transition-duration: 0.12s;
}

.slot-top    { left: 65px; top: 14px; }
.slot-right  { left: 116px; top: 65px; }
.slot-bottom { left: 65px; top: 116px; }
.slot-left   { left: 14px; top: 65px; }

.slot.ready-pulse {
    scale: 1.1;
    translate: 0 -2px;
}

.slot.used-pulse {
    scale: 0.86;
    translate: 0 2px;
}

.slot.locked {
    opacity: 0.35;
}

.slot-content {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    bottom: 10px;
    overflow: hidden;
}

.slot-icon-inner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #f0eee8;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.slot-flash.active {
    opacity: 0.72;
}

.slot-cooldown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    transform-origin: bottom center;
    scale: 1 1;
    background-color: rgba(22, 21, 19, 0.82);
}

.slot-timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
}

.slot-prompt {
    position: absolute;
    left: -16.75px;
    top: -10px;
    width: 103.5px;
    height: 26px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slot-prompt-image {
    display: none;
    width: 28px;
    height: 26px;
    padding: 2px;
    background-color: #161513;
    border-width: 2px;
    border-color: #F0EEE8;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-key-label {
    min-width: 28px;
    max-width: 103.5px;
    height: 24px;
    padding: 0 4px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #1B1A18;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
}


/* Locked marker keeps its anchor when the optional damage tab is hidden. */
.target-lock {
    position: absolute;
    display: none;
    width: 100px;
    height: 72px;
}

.target-lock.visible {
    display: flex;
}

.target-lock-readout {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 0;
    height: 34px;
    background-color: #1B1A18;
    border-width: 2px;
    border-color: #F0EEE8;
    border-bottom-width: 4px;
    border-bottom-color: #161513;
}

.target-lock.damage-hidden .target-lock-readout {
    display: none;
}

.target-lock-damage {
    margin: 0;
    padding: 0;
    flex-grow: 1;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
}

.target-lock-marker {
    position: absolute;
    left: 29px;
    bottom: 0;
    width: 42px;
    height: 26px;
}

.target-lock-bracket {
    position: absolute;
    top: 0;
    width: 10px;
    height: 15px;
    border-top-width: 3px;
    border-top-color: #EF4444;
}

.target-lock-bracket-left {
    left: 0;
    border-left-width: 3px;
    border-left-color: #EF4444;
}

.target-lock-bracket-right {
    right: 0;
    border-right-width: 3px;
    border-right-color: #EF4444;
}

.target-lock-pointer {
    position: absolute;
    top: 12px;
    width: 15px;
    height: 4px;
    background-color: #EF4444;
}

.target-lock-pointer-left {
    left: 8px;
    rotate: 45deg;
}

.target-lock-pointer-right {
    right: 8px;
    rotate: -45deg;
}

/* Match overlays share the frontend control language, not gameplay colors. */
.match-pause-cover {
    background-color: rgba(22, 21, 19, 0.72);
}

.match-pause-box {
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.match-pause-title {
    color: #1b1a18;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action {
    background-color: #f0eee8;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 5px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action--primary { background-color: #ffcc22; }

.match-pause-action:hover,
.match-pause-action:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.match-pause-action:active { translate: 0 3px; }

.match-pause-action:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

.shell-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.8);
}

.shell-modal-box {
    min-width: 320px;
    max-width: 560px;
    padding: 20px 24px;
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.shell-modal-title {
    color: #1b1a18;
    font-size: 24px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    white-space: normal;
}

.shell-modal-help {
    margin-top: 8px;
    margin-bottom: 14px;
    color: #252422;
    font-size: 15px;
    white-space: normal;
}

.shell-modal-row {
    flex-direction: row;
    align-items: stretch;
}

.shell-modal-submit {
    flex-grow: 1;
    min-height: 40px;
    margin-right: 6px;
    padding: 0 16px;
    background-color: #ffcc22;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.shell-modal-submit--secondary { background-color: #f0eee8; }

.shell-modal-submit:hover,
.shell-modal-submit:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.shell-modal-submit:active { translate: 0 3px; }

.shell-modal-submit:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

#steam-room-join-notice {
    background-color: rgba(22, 21, 19, 0.96);
    color: #f0eee8;
    border-width: 1px;
    border-color: #7b7872;
}
