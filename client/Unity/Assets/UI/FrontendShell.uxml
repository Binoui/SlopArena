<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="FrontendShell.uss" />
    <ui:Style src="SlopArena.uss" />
    <ui:VisualElement name="frontend-shell" class="frontend-shell">
        <ui:VisualElement name="shell-backdrop" class="shell-backdrop" picking-mode="Ignore" />
        <ui:VisualElement name="shell-top-bar" class="shell-top-bar">
            <ui:Button name="shell-wordmark" text="SLOPARENA" tooltip="Home" class="shell-wordmark" />
            <ui:VisualElement name="shell-nav" class="shell-nav">
                <ui:Button name="shell-nav-training" text="TRAINING" class="shell-nav-tab"><ui:VisualElement class="shell-nav-underline" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="shell-nav-offline" text="SOLO" class="shell-nav-tab"><ui:VisualElement class="shell-nav-underline" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="shell-nav-online" text="ONLINE" class="shell-nav-tab"><ui:VisualElement class="shell-nav-underline" picking-mode="Ignore" /></ui:Button>
            </ui:VisualElement>
            <ui:Label name="shell-page-context" text="" class="shell-page-context" />
            <ui:VisualElement name="shell-top-bar-spacer" class="shell-top-bar-spacer" />
            <ui:Label name="shell-topbar-hint" text="" class="shell-topbar-hint" picking-mode="Ignore" />
            <!-- Shared identity entry (issue #220): name plus true social
                 connection status; activating it opens the shared identity
                 surface. -->
            <ui:Button name="shell-settings" text="SETTINGS" class="shell-settings" />
            <ui:Button name="shell-identity" text="" class="shell-identity" />
            <ui:Button name="shell-menu-trigger" text="MENU" tooltip="Open menu (Esc / Start)" class="shell-menu-trigger">
                <ui:VisualElement class="shell-menu-gear" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="shell-workspace" class="shell-workspace">
            <ui:VisualElement name="page-header-host" class="shell-host shell-header-host" />
            <ui:VisualElement name="page-body-host" class="shell-host shell-body-host" />
            <ui:VisualElement name="shell-lower-row" class="shell-lower-row">
                <ui:VisualElement name="social-host" class="shell-host shell-social-host" />
                <ui:VisualElement name="page-lower-host" class="shell-host shell-page-lower-host">
                    <ui:VisualElement name="page-summary-host" class="shell-host shell-summary-host" />
                    <ui:VisualElement name="page-actions-host" class="shell-host shell-actions-host" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="expanded-social-host" class="shell-hidden" picking-mode="Ignore" />
        <ui:VisualElement name="modal-host" class="shell-modal-host" picking-mode="Ignore">
            <ui:VisualElement name="shell-escape-menu" class="shell-escape-menu">
                <ui:VisualElement class="shell-escape-card">
                    <ui:Label text="MENU" class="shell-escape-title" />
                    <ui:Button name="shell-menu-resume" text="RESUME" class="btn-primary shell-escape-action" />
                    <ui:Button name="shell-menu-settings" text="SETTINGS" class="btn-secondary shell-escape-action" />
                    <ui:Button name="shell-menu-quit" text="QUIT GAME" class="btn-back shell-escape-action" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
