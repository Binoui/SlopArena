<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SlopArena.uss?fileID=7433441132597879392&amp;guid=a41ba556d3415bfd586226903c56f69e&amp;type=3#SlopArena" />
    <ui:VisualElement name="root" class="screen char-select-screen">
        <ui:Label name="title" text="CHARACTER SELECT // SERVER LOBBY" class="title char-select-title" />
        <ui:Label name="roster-meta" text="4 FIGHTERS // 1 PLAYER" class="char-select-meta" />

        <ui:VisualElement name="char-grid" class="char-grid" />

        <ui:VisualElement name="selection-copy" class="selection-copy">
            <ui:Label name="char-name" text="—" class="char-name" />
            <ui:Label name="char-role" text="—" class="char-role" />
        </ui:VisualElement>

        <ui:VisualElement name="pvp-panel" class="pvp-panel">
            <ui:VisualElement name="player-cards-area" class="player-cards-area">
                <ui:VisualElement name="roster-panel" class="roster-panel" />
            </ui:VisualElement>
            <ui:VisualElement name="pvp-action-area" class="pvp-action-area">
                <ui:Label name="lbl-pvp-status" class="pvp-status" />
                <ui:VisualElement class="pvp-buttons">
                    <ui:Button name="btn-lockin" text="LOCK IN" class="btn-primary pvp-btn" />
                    <ui:Button name="btn-start-match" text="SELECT STAGE" class="btn-primary pvp-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button name="btn-select" text="SELECT FIGHTER" class="btn-primary" />
        <ui:Button name="btn-back" text="← BACK" class="btn-back" />

        <ui:VisualElement name="global-chat" class="global-chat">
            <ui:VisualElement class="global-chat__header">
                <ui:Label text="GLOBAL CHAT" class="global-chat__title" />
                <ui:Label text="1,204 ONLINE" class="global-chat__online" />
            </ui:VisualElement>
            <ui:VisualElement name="chat-feed" class="global-chat__feed">
                <ui:Label text="BonkLord: gg wp anyone up for 2v2?" class="global-chat__message" />
                <ui:Label text="slopqueen: pick your fighter" class="global-chat__message global-chat__message--accent" />
                <ui:Label text="dude420: host is up, join fast" class="global-chat__message global-chat__message--hot" />
            </ui:VisualElement>
            <ui:VisualElement class="global-chat__input-row">
                <ui:TextField name="chat-input" placeholdertext="type here…" class="global-chat__input" />
                <ui:Button name="chat-send" text="➜" class="global-chat__send" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
