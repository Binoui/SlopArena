<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SlopArena.uss?fileID=7433441132597879392&amp;guid=a41ba556d3415bfd586226903c56f69e&amp;type=3#SlopArena" />
    <ui:VisualElement name="root" class="screen" style="background-image: none;">
        <ui:Label name="title" text="SELECT CHARACTER" class="title" />
        <ui:VisualElement name="char-grid" class="char-grid" />
        <ui:VisualElement name="preview-panel" class="preview-panel">
            <ui:VisualElement name="abilities-left" class="abilities-col">
                <ui:VisualElement name="ability-q" class="ability-card">
                    <ui:Label name="ability-q-key" text="Q" class="ability-key" />
                    <ui:VisualElement class="ability-info">
                        <ui:Label name="ability-q-name" text="—" class="ability-name" />
                        <ui:Label name="ability-q-desc" class="ability-desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ability-e" class="ability-card">
                    <ui:Label name="ability-e-key" text="E" class="ability-key" />
                    <ui:VisualElement class="ability-info">
                        <ui:Label name="ability-e-name" text="—" class="ability-name" />
                        <ui:Label name="ability-e-desc" class="ability-desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="model-col" class="model-col">
                <ui:Label name="char-name" text="—" class="char-name" />
                <ui:VisualElement name="model-viewport" class="model-viewport">
                    <ui:VisualElement name="model-image" class="model-image" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="abilities-right" class="abilities-col">
                <ui:VisualElement name="ability-r" class="ability-card">
                    <ui:Label name="ability-r-key" text="R" class="ability-key" />
                    <ui:VisualElement class="ability-info">
                        <ui:Label name="ability-r-name" text="—" class="ability-name" />
                        <ui:Label name="ability-r-desc" class="ability-desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ability-f" class="ability-card">
                    <ui:Label name="ability-f-key" text="F" class="ability-key" />
                    <ui:VisualElement class="ability-info">
                        <ui:Label name="ability-f-name" text="—" class="ability-name" />
                        <ui:Label name="ability-f-desc" class="ability-desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pvp-panel" class="pvp-panel">
            <ui:VisualElement name="roster-panel" class="roster-panel" />
            <ui:Label name="lbl-pvp-status" class="pvp-status" />
            <ui:VisualElement class="pvp-buttons">
                <ui:Button name="btn-lockin" text="LOCK IN" class="btn-primary pvp-btn" />
                <ui:Button name="btn-start-match" text="SELECT STAGE" class="btn-primary pvp-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="btn-select" text="SELECT" class="btn-primary" />
        <ui:Button name="btn-back" text="← BACK" class="btn-back" />
        <ui:VisualElement name="global-chat" class="global-chat">
            <ui:VisualElement class="global-chat__header">
                <ui:Label text="GLOBAL CHAT" class="global-chat__title" />
                <ui:Label text="1,204 ONLINE" class="global-chat__online" />
            </ui:VisualElement>
            <ui:VisualElement name="chat-feed" class="global-chat__feed">
                <ui:Label text="BonkLord: gg wp anyone up for 2v2?" class="global-chat__message" />
                <ui:Label text="slopqueen: pick your fighter" class="global-chat__message global-chat__message--accent" />
                <ui:Label text="dude420: host is up, join fast" class="global-chat__message global-chat__message--hot" />
            </ui:VisualElement>
            <ui:VisualElement class="global-chat__input-row">
                <ui:TextField name="chat-input" placeholdertext="type here…" class="global-chat__input" />
                <ui:Button name="chat-send" text="➜" class="global-chat__send" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
