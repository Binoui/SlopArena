<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Lobby Room page fragment (issue #221). Mounted into the FrontendShell
         hosts: header (with the room identity) → PageHeaderHost, the roster
         scroll region → PageBodyHost, connection/readiness feedback →
         PageSummaryHost, leave/continue controls respecting authority →
         PageActionsHost. Real lobby state lives in LobbyRoomUI. -->
    <ui:VisualElement name="page-frag">
        <ui:VisualElement name="page-header" class="page-section lobby-header-section">
            <ui:Button name="btn-back" text="BACK" class="btn-back" />
            <ui:VisualElement class="flow-header-copy">
                <ui:Label name="title" text="LOBBY ROOM" class="flow-title" />
                <ui:Label text="See who's here, then leave when you're ready." class="flow-subtitle" />
            </ui:VisualElement>
            <ui:Label name="lbl-server" class="flow-context" />
        </ui:VisualElement>
        <ui:VisualElement name="page-body" class="page-section lobby-body-section">
            <ui:VisualElement name="lobby-panel" class="lobby-panel">
                <ui:VisualElement class="lobby-panel__header">
                    <ui:VisualElement>
                        <ui:Label text="PLAYER ROSTER" class="panel-title" />
                        <ui:Label text="Players in this room" class="panel-note" />
                    </ui:VisualElement>
                    <ui:Label text="UP TO 4 PLAYERS" class="lobby-panel__capacity" />
                </ui:VisualElement>
                <ui:ScrollView name="player-list-scroll" class="player-list-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="player-list" class="player-list lobby-list" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="page-summary" class="page-section lobby-summary-section">
            <ui:Label name="lbl-status" text="Connecting to the room…" class="lobby-status" />
            <ui:Label name="lbl-invite-hint" class="lobby-invite-hint" style="display: none;" />
            <ui:Button name="btn-retry" text="RETRY CONNECTION" class="btn-secondary lobby-retry" style="display: none;" />
        </ui:VisualElement>
        <ui:VisualElement name="page-actions" class="page-section lobby-actions-section">
            <ui:Button name="btn-invite" text="INVITE FRIEND" class="btn-secondary lobby-action lobby-action--invite" style="display: none;" />
            <ui:Button name="btn-leave" text="LEAVE ROOM" class="btn-secondary lobby-action lobby-action--leave" />
            <ui:Button name="btn-start" text="CHOOSE FIGHTERS" class="btn-primary lobby-action lobby-action--start" style="display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
