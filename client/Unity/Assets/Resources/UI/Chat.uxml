<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="Chat.uss" />
    <ui:Label name="chat-region-hint" class="chat-region-hint" picking-mode="Ignore" />
    <ui:VisualElement name="chat-root" class="chat-root">
        <ui:VisualElement name="chat-public-feed" class="chat-public-feed" />

        <ui:VisualElement name="chat-collapsed" class="chat-collapsed">
            <ui:Button name="chat-open" text="CHAT" class="chat-open" />
            <ui:Label name="chat-unread" class="chat-unread" />
        </ui:VisualElement>

        <!-- The shell owns account identity. This presenter owns chat channels,
             conversation state and its compact/expanded presentation. -->
        <ui:VisualElement name="chat-panel" class="chat-panel">

            <ui:VisualElement name="chat-main" class="chat-main">
                <ui:VisualElement class="chat-tabs">
                    <ui:Button name="chat-tab-global" text="GLOBAL" class="chat-tab" />
                    <ui:Button name="chat-tab-server" text="SERVER CHAT" class="chat-tab" />
                    <ui:Button name="chat-tab-direct" text="DIRECT" class="chat-tab" />
                </ui:VisualElement>

                <ui:VisualElement class="chat-body">
                    <ui:ScrollView name="conversation-list" class="conversation-list" horizontal-scroller-visibility="Hidden" />
                    <ui:VisualElement class="chat-detail">
                        <ui:Button name="directory-refresh" text="REFRESH PLAYERS" class="chat-action chat-action--small" />
                        <ui:Label name="online-feedback" class="chat-feedback" />
                        <ui:ScrollView name="online-list" class="online-list" horizontal-scroller-visibility="Hidden" />
                        <ui:ScrollView name="chat-history" class="chat-history" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                            <ui:Label name="history-feedback" class="chat-feedback chat-feedback--in-history" />
                        </ui:ScrollView>
                        <ui:Button name="chat-newest" text="RETURN TO NEWEST" class="chat-newest" />
                        <ui:VisualElement class="chat-compose">
                            <ui:TextField name="chat-draft" placeholdertext="Message literally…" class="chat-draft" />
                            <ui:Button name="chat-send" text="SEND" class="chat-action chat-action--primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="chat-corner-actions" class="chat-corner-actions">
                <ui:Button name="chat-expand" tooltip="Expand chat" class="chat-icon-button">
                    <ui:VisualElement class="chat-icon-expand" picking-mode="Ignore">
                        <ui:VisualElement class="chat-icon-expand-corner chat-icon-expand-corner--top" picking-mode="Ignore" />
                        <ui:VisualElement class="chat-icon-expand-corner chat-icon-expand-corner--bottom" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="chat-close" tooltip="Minimize chat" class="chat-icon-button">
                    <ui:VisualElement name="chat-close-icon" class="chat-icon-minimize" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="chat-resize-grip" class="chat-resize-grip" tooltip="Drag to resize chat">
                <ui:VisualElement class="chat-resize-mark" picking-mode="Ignore" />
                <ui:VisualElement class="chat-resize-mark chat-resize-mark--second" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
