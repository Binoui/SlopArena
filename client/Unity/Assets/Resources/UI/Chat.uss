:root {
    --chat-ink: rgb(27, 26, 24);
    --chat-deep-ink: rgb(22, 21, 19);
    --chat-paper: rgb(240, 238, 232);
    --chat-acid: rgb(255, 204, 34);
    --chat-orange: rgb(255, 151, 119);
    --chat-green: rgb(117, 230, 165);
    --chat-muted: rgb(194, 191, 185);
    --chat-border: rgb(123, 120, 114);
    --chat-surface: rgb(37, 36, 34);
}

.chat-root {
    position: absolute;
    right: 24px;
    bottom: 94px;
    width: 540px;
    height: 620px;
    align-items: stretch;
    justify-content: flex-end;
    color: var(--chat-paper);
}

/* Explicit Page/Social region-switch affordance (issue #215). Sits at the
   bottom-left of the attached surface, opposite the chat strip. Text is set
   by ChatOverlay: the region the switch reaches. */
.chat-region-hint {
    display: none;
    position: absolute;
    left: 16px;
    bottom: 12px;
    padding: 4px 9px;
    background-color: rgba(22, 21, 19, 0.96);
    border-left-width: 3px;
    border-left-color: var(--chat-acid);
    color: var(--chat-muted);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.chat-collapsed {
    min-height: 42px;
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    justify-content: flex-start;
    padding: 4px;
    background-color: var(--chat-deep-ink);
}

.chat-open {
    width: 88px;
    min-height: 38px;
    margin-left: 0;
    border-width: 2px;
    border-color: var(--chat-ink);
    border-bottom-width: 5px;
    background-color: var(--chat-acid);
    color: var(--chat-ink);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-open:hover,
.chat-open:focus {
    background-color: rgb(255, 220, 92);
    border-color: var(--chat-paper);
}

.chat-open:active { translate: 0 3px; }


.chat-unread {
    display: none;
    min-width: 22px;
    height: 22px;
    margin-right: 8px;
    padding-left: 5px;
    padding-right: 5px;
    background-color: var(--chat-orange);
    color: var(--chat-ink);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.chat-unread--visible { display: flex; }


.chat-public-feed {
    position: absolute;
    right: 0;
    bottom: 48px;
    width: 100%;
    min-height: 0;
    flex-direction: column;
    align-items: flex-end;
    overflow: hidden;
}

.chat-public-line {
    max-width: 100%;
    min-height: 22px;
    margin-top: 4px;
    padding: 5px 8px;
    background-color: rgba(22, 21, 19, 0.96);
    border-left-width: 3px;
    border-left-color: var(--chat-acid);
    color: var(--chat-paper);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Gameplay anchors left: the compact strip and public feed follow the
   frame instead of staying right-aligned inside it. */
.chat-root--gameplay .chat-public-feed {
    right: auto;
    left: 0;
    align-items: flex-start;
}

.chat-panel {
    display: none;
    flex-grow: 1;
    min-height: 0;
    padding: 4px;
    position: relative;
    flex-direction: column;
    background-color: rgba(22, 21, 19, 0.97);
    border-width: 2px;
    border-color: var(--chat-paper);
    border-bottom-width: 2px;
    border-bottom-color: var(--chat-paper);
}

/* Docked and compact-replacement chat stays opaque over its host surface. */
.chat-panel--solid { background-color: var(--chat-deep-ink); }

.chat-resize-grip {
    position: relative;
    width: 26px;
    height: 26px;
    margin-left: 4px;
    border-width: 1px;
    border-color: var(--chat-ink);
    background-color: var(--chat-paper);
}
.chat-resize-grip:hover,
.chat-resize-grip:focus { border-color: var(--chat-acid); }
.chat-resize-mark {
    position: absolute;
    left: 2px;
    top: 7px;
    width: 13px;
    height: 2px;
    rotate: -45deg;
    background-color: var(--chat-ink);
}
.chat-resize-mark--second { left: 6px; top: 11px; width: 8px; }

.chat-corner-actions {
    position: absolute;
    top: 4px;
    right: 4px;
    flex-direction: row;
    align-items: center;
}

.chat-section-label {
    color: var(--chat-acid);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
}

.chat-icon-button {
    width: 26px;
    height: 26px;
    min-height: 26px;
    margin-left: 4px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--chat-ink);
    background-color: var(--chat-paper);
}
.chat-icon-button:hover, .chat-icon-button:focus { border-color: var(--chat-acid); }

.chat-icon-minimize { width: 14px; height: 2px; background-color: var(--chat-ink); }

.chat-action--small,
.chat-newest,
.chat-mute {
    min-height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: var(--chat-border);
    background-color: var(--chat-surface);
    color: var(--chat-paper);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-action--small:hover,
.chat-action--small:focus,
.chat-newest:hover,
.chat-newest:focus,
.chat-mute:hover,
.chat-mute:focus {
    border-color: var(--chat-acid);
    color: var(--chat-acid);
}

.chat-action {
    min-height: 36px;
    border-width: 2px;
    border-color: var(--chat-ink);
    border-bottom-width: 4px;
    background-color: var(--chat-acid);
    color: var(--chat-ink);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-action--primary:hover,
.chat-action--primary:focus {
    background-color: rgb(255, 220, 92);
    border-color: var(--chat-paper);
}

.chat-action:disabled,
.chat-tab:disabled,
.chat-open:disabled,
.chat-action--small:disabled,
.chat-newest:disabled,
.chat-mute:disabled,
.chat-icon-button:disabled,
.conversation-select:disabled,
.online-player:disabled {
    background-color: var(--chat-surface);
    border-color: var(--chat-border);
    color: var(--chat-muted);
    translate: 0 0;
}

.chat-feedback {
    min-height: 18px;
    margin-top: 5px;
    color: var(--chat-muted);
    font-size: 12px;
    letter-spacing: 0.4px;
    white-space: normal;
}
.chat-feedback--in-history {
    margin-top: 8px;
    padding: 6px;
    color: var(--chat-orange);
    font-size: 11px;
}
.chat-feedback--success { color: var(--chat-green); }
.chat-feedback--pending { color: var(--chat-muted); }

.chat-main {
    display: none;
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

/* Menu and gameplay share the paper frame and high-contrast controls. */
.chat-panel--menu {
    background-color: var(--chat-deep-ink);
}


.chat-panel--menu .chat-icon-button:hover,
.chat-panel--menu .chat-icon-button:focus,
.chat-panel--menu .chat-resize-grip:hover {
    border-color: var(--chat-acid);
    background-color: var(--chat-acid);
}

.chat-panel--menu .chat-icon-minimize { background-color: var(--chat-ink); }
.chat-panel--menu .chat-resize-mark { background-color: var(--chat-ink); }

.chat-panel--menu .chat-draft,
.chat-panel--menu .chat-draft .unity-base-text-field__input {
    background-color: var(--chat-deep-ink);
    color: var(--chat-paper);
}
.chat-panel--menu .chat-draft {
    border-color: var(--chat-paper);
}
.chat-panel--menu .chat-draft:focus {
    border-color: var(--chat-acid);
}
.chat-panel--menu .chat-draft .unity-base-text-field__input:focus {
    border-width: 1px;
    border-color: var(--chat-acid);
}
.chat-panel--menu .chat-draft .unity-base-text-field__input--placeholder {
    color: var(--chat-muted);
}

.chat-compose .chat-action {
    background-color: var(--chat-acid);
    border-color: var(--chat-ink);
    color: var(--chat-ink);
}
.chat-compose .chat-action:hover,
.chat-compose .chat-action:focus {
    background-color: var(--chat-paper);
    border-color: var(--chat-acid);
    color: var(--chat-ink);
    translate: 0 0;
}
.chat-compose .chat-action:disabled {
    background-color: var(--chat-paper);
    border-color: var(--chat-ink);
    color: rgb(85, 83, 79);
    opacity: 1;
}
.chat-compose .chat-action:active { translate: 0 3px; }

/* Short utility controls share a clear focus treatment and physical press. */
.chat-icon-button:hover,
.chat-icon-button:focus,
.chat-action--small:hover,
.chat-action--small:focus,
.chat-newest:hover,
.chat-newest:focus,
.chat-mute:hover,
.chat-mute:focus {
    border-color: var(--chat-acid);
    color: var(--chat-acid);
}

.chat-open:active,
.chat-action:active,
.chat-action--small:active,
.chat-newest:active,
.chat-mute:active,
.chat-icon-button:active,
.chat-tab:active,
.conversation-select:active,
.online-player:active {
    translate: 0 3px;
}
.chat-action:disabled,
.chat-tab:disabled,
.chat-open:disabled,
.chat-action--small:disabled,
.chat-newest:disabled,
.chat-mute:disabled,
.chat-icon-button:disabled,
.conversation-select:disabled,
.online-player:disabled {
    translate: 0 0;
}
.chat-compose .chat-action:disabled { translate: 0 0; }

/* Directory section labels inside the explicit DIRECT view. */
.online-list .chat-section-label {
    margin-top: 6px;
    margin-bottom: 2px;
}

.chat-tabs {
    height: 38px;
    margin-top: 0;
    margin-right: 64px;
    flex-direction: row;
}

.chat-tab {
    flex-grow: 1;
    min-height: 32px;
    margin-right: 4px;
    border-width: 1px;
    border-color: var(--chat-ink);
    background-color: var(--chat-paper);
    color: var(--chat-ink);
    font-size: 11px;
    letter-spacing: 0;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-tab-underline {
    position: absolute;
    bottom: 2px;
    left: 50%;
    margin-left: -16px;
    width: 32px;
    height: 2px;
    background-color: transparent;
}

#chat-tab-direct {
    margin-right: 0;
}

.chat-tab--active,
.chat-tab:hover,
.chat-tab:focus {
    border-color: var(--chat-acid);
    background-color: var(--chat-acid);
    color: var(--chat-ink);
}

.chat-tab:disabled {
    background-color: var(--chat-paper);
    border-color: var(--chat-ink);
    color: rgb(85, 83, 79);
    opacity: 1;
}

.chat-body {
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
    flex-direction: row;
}


.conversation-row {
    min-height: 32px;
    margin-bottom: 4px;
    flex-direction: row;
    align-items: stretch;
}

.conversation-row--active {
    border-left-width: 3px;
    border-left-color: var(--chat-acid);
}

.conversation-select {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    padding: 4px;
    border-width: 0;
    background-color: transparent;
    color: var(--chat-paper);
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.conversation-select:hover,
.conversation-select:focus {
    background-color: rgb(50, 49, 46);
    color: var(--chat-acid);
}

.conversation-unread {
    min-width: 18px;
    height: 18px;
    margin-top: 6px;
    margin-right: 3px;
    background-color: var(--chat-orange);
    color: var(--chat-ink);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.chat-detail {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
}


.online-list {
    display: none;
    max-height: 130px;
    margin-top: 4px;
    padding: 4px;
    overflow: hidden;
    background-color: var(--chat-surface);
    border-width: 1px;
    border-color: var(--chat-border);
}

.online-row {
    min-height: 28px;
    flex-direction: row;
    align-items: center;
}

.online-player {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 26px;
    padding-left: 4px;
    border-width: 0;
    background-color: transparent;
    color: var(--chat-paper);
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.online-player:hover,
.online-player:focus {
    color: var(--chat-acid);
}

.chat-history {
    flex-grow: 1;
    min-height: 130px;
    margin-top: 6px;
    padding: 5px;
    background-color: var(--chat-deep-ink);
    border-width: 1px;
    border-color: var(--chat-paper);
}
.chat-empty {
    padding: 8px;
    color: var(--chat-paper);
    font-size: 12px;
    white-space: normal;
}


.chat-message {
    min-height: 30px;
    margin-bottom: 4px;
    padding: 4px 3px;
    flex-direction: row;
    align-items: flex-start;
    border-bottom-width: 1px;
    border-bottom-color: rgba(123, 120, 114, 0.35);
}

.chat-message__text {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    color: var(--chat-paper);
    font-size: 13px;
    white-space: normal;
}

.chat-message .chat-mute {
    min-width: 46px;
    margin-left: 5px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 10px;
}

.chat-newest {
    display: none;
    align-self: flex-end;
    margin-top: 4px;
    color: var(--chat-acid);
}

.chat-compose {
    min-height: 38px;
    margin-top: 6px;
    flex-direction: row;
    align-items: stretch;
}

.chat-draft {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 36px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: var(--chat-paper);
    background-color: var(--chat-deep-ink);
    color: var(--chat-paper);
    font-size: 13px;
}

.chat-draft .unity-base-text-field__input {
    background-color: var(--chat-deep-ink);
    color: var(--chat-paper);
}

.chat-draft:focus,
.chat-draft .unity-base-text-field__input:focus {
    border-color: var(--chat-acid);
    background-color: var(--chat-surface);
}

.chat-draft .unity-base-text-field__input--placeholder {
    color: var(--chat-muted);
}

.chat-compose .chat-action {
    width: 68px;
    margin-left: 5px;
}
