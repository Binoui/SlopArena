.sa-settings-cover {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 20, 0.93);
    color: rgb(240, 238, 232);
    font-size: 15px;
}

.sa-settings-poster {
    width: 94%;
    max-width: 1060px;
    height: 88%;
    max-height: 780px;
    min-height: 470px;
    padding: 22px 26px;
    background-color: rgb(23, 19, 27);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-color: rgb(13, 13, 20);
    border-top-color: rgb(13, 13, 20);
    border-right-color: rgb(13, 13, 20);
    border-bottom-color: rgb(224, 92, 42);
}

.sa-settings-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.sa-settings-title {
    color: rgb(240, 238, 232);
    font-size: 48px;
    -unity-font-definition: url("../../Fonts/Baloo2.asset");
    -unity-font-style: bold;
}

.sa-settings-mark {
    color: rgb(255, 200, 33);
    font-size: 11px;
    letter-spacing: 2px;
}

.sa-settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 12px;
    margin-bottom: 14px;
}

.sa-settings-tab {
    min-height: 42px;
    min-width: 115px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(36, 32, 43);
    color: rgb(240, 238, 232);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(13, 13, 20);
    border-top-color: rgb(13, 13, 20);
    border-right-color: rgb(13, 13, 20);
    border-bottom-color: rgb(13, 13, 20);
    font-size: 14px;
    -unity-font-style: bold;
}

.sa-settings-tab--selected {
    background-color: rgb(240, 238, 232);
    color: rgb(23, 19, 27);
    border-bottom-color: rgb(224, 92, 42);
}

.sa-settings-tab:hover, .sa-settings-tab:focus,
.sa-settings-action:hover, .sa-settings-action:focus {
    border-top-color: rgb(255, 200, 33);
    border-left-color: rgb(255, 200, 33);
    border-right-color: rgb(255, 200, 33);
}

.sa-settings-scroll {
    flex-grow: 1;
    min-height: 100px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 18px;
    padding-bottom: 12px;
    background-color: rgb(13, 13, 20);
}

.sa-settings-body { color: rgb(240, 238, 232); }
.sa-settings-columns { flex-direction: row; flex-wrap: wrap; }
.sa-settings-column { flex-grow: 1; flex-basis: 330px; min-width: 0; }
.sa-settings-column--first { margin-right: 12px; }

.sa-settings-row, .sa-settings-binding-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(36, 32, 43);
}

.sa-settings-row-label {
    flex-grow: 1;
    min-width: 105px;
    color: rgb(240, 238, 232);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.sa-settings-slider { width: 38%; min-width: 100px; }
.sa-settings-value, .sa-settings-status {
    color: rgb(255, 200, 33);
    font-size: 14px;
}
.sa-settings-value { width: 52px; -unity-text-align: middle-right; }
.sa-settings-binding-current { width: 140px; color: rgb(240, 238, 232); }

.sa-settings-field {
    min-height: 44px;
    margin-bottom: 8px;
    background-color: rgb(36, 32, 43);
    color: rgb(240, 238, 232);
    border-bottom-width: 2px;
    border-bottom-color: rgb(224, 92, 42);
}
.sa-settings-field:focus { border-bottom-color: rgb(255, 200, 33); }
.sa-settings-field .unity-base-field__label { color: rgb(240, 238, 232); }
.sa-settings-field .unity-base-field__input { color: rgb(240, 238, 232); }
.sa-settings-toggle {
    min-height: 44px;
    margin-bottom: 8px;
    padding-left: 12px;
    background-color: rgb(36, 32, 43);
    color: rgb(240, 238, 232);
}
.sa-settings-toggle .unity-base-field__label { color: rgb(240, 238, 232); }
.sa-settings-note { color: rgb(196, 189, 197); white-space: normal; }

.sa-settings-status { min-height: 18px; margin-top: 6px; white-space: normal; }
.sa-settings-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
}
.sa-settings-spacer { flex-grow: 1; }
.sa-settings-action {
    min-height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(36, 32, 43);
    color: rgb(240, 238, 232);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(13, 13, 20);
    border-top-color: rgb(13, 13, 20);
    border-right-color: rgb(13, 13, 20);
    border-bottom-color: rgb(13, 13, 20);
    font-size: 13px;
    -unity-font-style: bold;
}
.sa-settings-action--primary {
    min-width: 140px;
    background-color: rgb(255, 200, 33);
    color: rgb(23, 19, 27);
    border-bottom-color: rgb(224, 92, 42);
}
.sa-settings-action:disabled { opacity: 0.5; }

.sa-settings-confirmation {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 20, 0.9);
}
.sa-settings-confirmation-card {
    width: 90%;
    max-width: 480px;
    padding: 22px;
    background-color: rgb(23, 19, 27);
    border-bottom-width: 7px;
    border-bottom-color: rgb(224, 92, 42);
}
.sa-settings-confirmation-title { color: rgb(240, 238, 232); font-size: 18px; white-space: normal; }
.sa-settings-confirmation-actions { flex-direction: row; margin-top: 18px; }
.sa-settings-confirmation-actions .sa-settings-action { flex-grow: 1; margin-right: 8px; }
