.sa-settings-cover {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.94);
    color: rgb(240, 238, 232);
    font-size: 15px;
}

.sa-settings-poster {
    width: 94%;
    max-width: 1060px;
    height: 88%;
    max-height: 780px;
    min-height: 470px;
    padding: 22px 26px;
    background-color: rgb(240, 238, 232);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(255, 204, 34);
}

.sa-settings-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.sa-settings-title {
    color: rgb(27, 26, 24);
    font-size: 48px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.sa-settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 12px;
    margin-bottom: 14px;
}

.sa-settings-tab {
    min-height: 42px;
    min-width: 115px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    font-size: 14px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.sa-settings-tab--selected {
    background-image: none;
    background-color: rgb(255, 204, 34);
    color: rgb(27, 26, 24);
    border-bottom-color: rgb(22, 21, 19);
}

.sa-settings-tab:hover {
    background-color: rgb(255, 204, 34);
    border-top-color: rgb(27, 26, 24);
    border-left-color: rgb(27, 26, 24);
    border-right-color: rgb(27, 26, 24);
}

.sa-settings-tab:focus {
    background-color: rgb(27, 26, 24);
    color: rgb(240, 238, 232);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}

.sa-settings-tab:active { translate: 0 3px; }

.sa-settings-scroll {
    flex-grow: 1;
    min-height: 100px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 18px;
    padding-bottom: 12px;
    background-color: rgb(22, 21, 19);
    border-width: 2px;
    border-color: rgb(27, 26, 24);
}

.sa-settings-body { color: rgb(240, 238, 232); }
.sa-settings-columns { flex-direction: row; flex-wrap: wrap; }
.sa-settings-column { flex-grow: 1; flex-basis: 330px; min-width: 0; }
.sa-settings-column--first { margin-right: 12px; }

.sa-settings-row, .sa-settings-binding-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(37, 36, 34);
}

.sa-settings-row-label {
    flex-grow: 1;
    min-width: 105px;
    color: rgb(240, 238, 232);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.sa-settings-slider { width: 38%; min-width: 100px; }
.sa-settings-value {
    color: rgb(255, 204, 34);
    font-size: 14px;
}
.sa-settings-value { width: 52px; -unity-text-align: middle-right; }
.sa-settings-status {
    color: rgb(27, 26, 24);
    font-size: 14px;
}
.sa-settings-binding-current { width: 140px; color: rgb(240, 238, 232); }

.sa-settings-scroll .sa-settings-slider .unity-base-slider__tracker {
    background-image: none;
    background-color: rgb(123, 120, 114);
}
.sa-settings-scroll .sa-settings-slider .unity-base-slider__dragger {
    background-image: none;
    background-color: rgb(255, 204, 34);
    border-color: rgb(22, 21, 19);
}
.sa-settings-scroll .sa-settings-slider:focus .unity-base-slider__dragger {
    border-color: rgb(240, 238, 232);
}

.sa-settings-field {
    min-height: 44px;
    margin-bottom: 8px;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-bottom-width: 2px;
    border-bottom-color: rgb(123, 120, 114);
}
.sa-settings-field:focus { border-bottom-color: rgb(255, 204, 34); }
.sa-settings-field .unity-base-field__label { color: rgb(240, 238, 232); }
.sa-settings-field .unity-base-field__input {
    background-color: rgb(22, 21, 19);
    color: rgb(240, 238, 232);
}
.sa-settings-field .unity-base-field__input .unity-text-element { color: rgb(240, 238, 232); }
.sa-settings-field .unity-base-field__input .unity-base-popup-field__text { color: rgb(240, 238, 232); }
.sa-settings-field .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(240, 238, 232); }
.sa-settings-toggle {
    min-height: 44px;
    margin-bottom: 8px;
    padding-left: 12px;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
}
.sa-settings-toggle .unity-base-field__label { color: rgb(240, 238, 232); }
.sa-settings-toggle .unity-toggle__input {
    background-color: rgb(22, 21, 19);
    border-color: rgb(123, 120, 114);
}
.sa-settings-toggle .unity-toggle__checkmark {
    background-color: rgb(22, 21, 19);
    border-color: rgb(123, 120, 114);
    -unity-background-image-tint-color: rgb(27, 26, 24);
}
.sa-settings-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(255, 204, 34);
    border-color: rgb(255, 204, 34);
}
.sa-settings-toggle:focus .unity-toggle__checkmark { border-color: rgb(240, 238, 232); }
.sa-settings-note { color: rgb(240, 238, 232); white-space: normal; }

.sa-settings-status { min-height: 18px; margin-top: 6px; white-space: normal; }
.sa-settings-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
}
.sa-settings-spacer { flex-grow: 1; }
.sa-settings-body .sa-settings-action {
    min-height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    font-size: 13px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
.sa-settings-body .sa-settings-action:hover,
.sa-settings-body .sa-settings-action:focus {
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}
.sa-settings-body .sa-settings-action:active { translate: 0 3px; }
.sa-settings-body .sa-settings-action:disabled {
    background-image: none;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-color: rgb(123, 120, 114);
}
.sa-settings-footer .sa-settings-action {
    min-height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    font-size: 13px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
.sa-settings-footer .sa-settings-action:hover,
.sa-settings-footer .sa-settings-action:focus {
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}
.sa-settings-footer .sa-settings-action:active { translate: 0 3px; }
.sa-settings-footer .sa-settings-action--primary {
    min-width: 140px;
    background-image: none;
    background-color: rgb(255, 204, 34);
    color: rgb(27, 26, 24);
    border-bottom-color: rgb(22, 21, 19);
}
.sa-settings-footer .sa-settings-action--primary:hover,
.sa-settings-footer .sa-settings-action--primary:focus {
    background-image: none;
    background-color: rgb(27, 26, 24);
    color: rgb(240, 238, 232);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}
.sa-settings-footer .sa-settings-action:disabled {
    background-image: none;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-color: rgb(123, 120, 114);
}

.sa-settings-confirmation {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.9);
}
.sa-settings-confirmation-card {
    width: 90%;
    max-width: 480px;
    padding: 22px;
    background-color: rgb(240, 238, 232);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 7px;
    border-color: rgb(27, 26, 24);
}
.sa-settings-confirmation-title {
    color: rgb(27, 26, 24);
    font-size: 18px;
    white-space: normal;
}
.sa-settings-confirmation-actions { flex-direction: row; margin-top: 18px; }
.sa-settings-confirmation-actions .sa-settings-action {
    flex-grow: 1;
    margin-right: 8px;
    min-height: 44px;
    padding-left: 12px;
    padding-right: 12px;
    background-image: none;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
.sa-settings-confirmation-actions .sa-settings-action:hover,
.sa-settings-confirmation-actions .sa-settings-action:focus {
    background-image: none;
    color: rgb(27, 26, 24);
    background-color: rgb(255, 204, 34);
    border-top-color: rgb(27, 26, 24);
    border-left-color: rgb(27, 26, 24);
    border-right-color: rgb(27, 26, 24);
}
.sa-settings-confirmation-actions .sa-settings-action:active { translate: 0 3px; }
.sa-settings-confirmation-actions .sa-settings-action:disabled {
    background-image: none;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-color: rgb(123, 120, 114);
}

.sa-settings-cover .sa-settings-action:disabled:active {
    translate: 0 0;
}
