.ts-panel {
    width: 300px;
    padding: 14px 16px 16px 16px;
    flex-direction: column;
    background-color: rgba(27, 26, 24, 0.98);
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 5px;
    border-bottom-color: #7b7872;
}

.ts-title {
    font-size: 20px;
    letter-spacing: 0;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    color: #f0eee8;
    margin-bottom: 12px;
}

.ts-toggle {
    font-size: 14px;
    color: #f0eee8;
    margin-bottom: 12px;
}

.ts-label {
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: #f0eee8;
    margin-bottom: 4px;
}

.ts-dmg {
    flex-grow: 1;
    min-width: 0;
    white-space: nowrap;
}

.ts-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.ts-btn-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.ts-wrap {
    flex-wrap: wrap;
}

.ts-btn {
    height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 6px;
    margin-bottom: 6px;
    font-size: 12px;
    letter-spacing: 0;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #1b1a18;
    background-color: #f0eee8;
    border-width: 1px;
    border-color: #161513;
    border-bottom-width: 3px;
    -unity-text-align: middle-center;
}

.ts-btn:hover,
.ts-btn:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.ts-mode-btn.active {
    background-color: #ffcc22;
    color: #1b1a18;
}

.ts-mode-btn.active:focus {
    border-color: #f0eee8;
}

.ts-btn:active { translate: 0 3px; }

.ts-btn:disabled {
    opacity: 1;
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

.ts-toggle .unity-toggle__input {
    background-color: #161513;
    border-color: #7b7872;
}

.ts-toggle .unity-toggle__checkmark {
    background-color: #161513;
    border-color: #7b7872;
    -unity-background-image-tint-color: #1b1a18;
}

.ts-toggle:focus .unity-toggle__checkmark { border-color: #f0eee8; }
.ts-toggle:checked .unity-toggle__checkmark {
    background-color: #ffcc22;
    border-color: #ffcc22;
}
