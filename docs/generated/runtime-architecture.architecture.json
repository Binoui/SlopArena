  "cards": [
    {
      "dot": "cyan",
      "title": "Primary runtime path",
      "items": [
        "Unity polls InputSystem and sends InputState over UDP.",
        "Each MatchInstance drains inputs, advances ServerSimulation at 60 Hz, and broadcasts state/events.",
        "Unity renders authoritative state; it does not decide damage, timing, or match admission."
      ]
    },
    {
      "dot": "violet",
      "title": "Content and determinism",
      "items": [
        "CharacterPackages are compiled and Unity assets/poses are cooked into content-cooked/.",
        "The Match Content Catalog pins package IDs, versions, dependencies, capability versions, and hashes.",
        "Missing, stale, incompatible, or hash-mismatched content fails closed."
      ]
    },
    {
      "dot": "rose",
      "title": "External dependencies",
      "items": [
        "Master Server owns lobby, server browser, character selection, match start, and results metadata.",
        "Unity supplies presentation, animation, camera, UI, VFX, audio, and transport adapters.",
        "GameServer hosts matches; Shared code is the gameplay authority boundary."
      ]
    }
  ]
