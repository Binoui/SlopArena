# ==========================================
# Unity (client/)
# ==========================================
client/Unity/[Ll]ibrary/
client/Unity/[Tt]emp/
client/Unity/[Oo]bj/
client/Unity/[Bb]uild/
client/Unity/[Bb]uilds/
client/Unity/[Ll]ogs/
client/Unity/[Uu]serSettings/
client/Unity/[Mm]emoryCapturer/
client/Unity/.vs/
client/Unity/*.csproj
client/Unity/*.uid
client/Unity/*.sln
client/Unity/*.user
client/Unity/Assets/Shared/*.pdb
client/Unity/Assets/Shared/*.deps.json
client/Unity/Assets/Shared/*.meta
client/Unity/Assets/Shared/*.runtimeconfig.json

# Root Unity artifacts (orphaned)
/Library/
/Logs/
/UserSettings/
/Temp/

# Third-party animation/model packs (non-redistributable)
client/Unity/Assets/~AnimationPacks/
client/Unity/Assets/~AnimationPacks.meta
client/Unity/Assets/AnimationPacks/
client/Unity/Assets/AnimationPacks.meta

# Character art (models, textures, materials — non-redistributable)
client/Unity/Assets/Art/
client/Unity/Assets/Art.meta

# Root-level prototype assets
/assets/

# Unity directories without tracked content
client/Unity/Assets/Editor.meta
client/Unity/Assets/Samples.meta
client/Unity/Assets/Plugins/SlopArena.Shared.meta
client/Unity/Assets/Plugins/SlopArena.Shared/
client/Unity/Assets/Scenes/Arena_Offline/Materials.meta
client/Unity/Assets/Resources/Icons/

# Unity Plugins — third-party DLLs (NuGet, Animancer, etc.)
client/Unity/Assets/Plugins/**/*.dll
client/Unity/Assets/Plugins/**/*.pdb
client/Unity/Assets/Plugins/**/*.deps.json
client/Unity/Assets/Plugins/**/*.runtimeconfig.json
client/Unity/Assets/Plugins/**/NuGet/.nuget-installed.json

# Binary asset types — non-redistributable art/animation data
*.fbx
*.FBX
*.anim
*.png
*.tga
*.jpg
*.jpeg
*.mat
*.mask
*.exr
*.hdr
*.zip
*.unitypackage
*.pdf
*.glb
*.gltf
*.controller
*.overrideController
*.renderTexture
*.terrainlayer
*.vfx
*.vfxgraph
*.shadervariants

# Auto-generated prefabs from symlinked asset packs (regenerate on clone)
client/Unity/Assets/Prefabs/Arena_*.prefab
client/Unity/Assets/Prefabs/Arena_*.prefab.meta
client/Unity/Assets/Prefabs/Bridge_*.prefab
client/Unity/Assets/Prefabs/Bridge_*.prefab.meta

# Prevent Unity .meta file leaks into pure .NET Shared directory
src/Shared/**/*.meta

# Orphan Godot .uid metadata
*.uid.meta

# Unity crash dumps
client/Unity/mono_crash.mem.*

# Duplicate runtime data (source of truth in /data/)
client/Unity/data/

# Paid assets — do not commit
client/Unity/Packages/com.kybernetik.animancer/
client/Unity/Assets/BOXOPHOBIC/

.worktrees/

# Superpowers brainstorm session state
.superpowers/
