[Unit]
Description=SlopArena private CI SSH receiver
Requires=ssh.service wg-quick@sloparena-ci.service
After=ssh.service wg-quick@sloparena-ci.service

[Service]
Type=notify
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config.sloparena-ci
ExecStartPre=/opt/sloparena/deploy/vps/ci-network-firewall --verify
ExecStartPre=/usr/local/sbin/sloparena-vps-docker-firewall --verify
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config.sloparena-ci
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
